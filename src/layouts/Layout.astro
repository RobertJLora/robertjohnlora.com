---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  currentSlug?: string;
  isHomepage?: boolean;
  noindex?: boolean;
}

const defaultDescription = "Robert Lora, Director of SEO at uSERP. Grew organic traffic 300%+ for B2B SaaS companies like Blink, OnBoard, and Form Health. 45 tools built with Claude Code.";
const defaultImage = "/og-image.png";

const { title, description, image, currentSlug, isHomepage, noindex } = Astro.props;
const pageDescription = description || defaultDescription;
const pageImage = image || defaultImage;
const siteUrl = "https://robertjohnlora.com";
const fullImageUrl = pageImage.startsWith('http') ? pageImage : `${siteUrl}${pageImage}`;
// The page's own URL as served (trailing slash). currentSlug only picks the active tab,
// so sub-pages like /play/surge/ must not take their canonical from it.
const pagePath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const pageUrl = `${siteUrl}${pagePath}`;
const fullTitle = isHomepage ? 'Robert Lora | Director of SEO at uSERP' : `${title} | Robert Lora`;

// The tabs are the only section navigation. Each one is a real page.
const tabs = [
  { id: 'about', href: '/' },
  { id: 'work', href: '/case-studies/' },
  { id: 'builds', href: '/builds/' },
  { id: 'umbra', href: '/umbra/' },
  { id: 'play', href: '/play/' },
  { id: 'notes', href: '/resources/' },
  { id: 'contact', href: '/quick-links/' },
];
const slugToTab: Record<string, string> = {
  'about-me': 'about',
  'case-studies': 'work',
  builds: 'builds',
  umbra: 'umbra',
  play: 'play',
  resources: 'notes',
  quotes: 'notes',
  'quick-links': 'contact',
};
const activeTab = currentSlug ? slugToTab[currentSlug] : undefined;
const game = pagePath.match(/^\/play\/([^/]+)\/$/)?.[1];
const cwd = game ? `~/play/${game}` : !activeTab || activeTab === 'about' ? '~' : `~/${activeTab}`;
const EMAIL = 'rjlora@gmail.com';
---

<!DOCTYPE html>
<html lang="en" class="no-js" data-cwd={cwd} data-game={game ? 'true' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/GeistMono-variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#1f1d2e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f2e9e1" media="(prefers-color-scheme: light)" />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Robert Lora" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Robert Lora" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- Canonical -->
    <link rel="canonical" href={pageUrl} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${siteUrl}/#website`,
          "name": "Robert Lora",
          "url": siteUrl,
          "description": defaultDescription,
          "inLanguage": "en-US"
        },
        ...(isHomepage ? [{
          "@type": "ProfilePage",
          "@id": `${siteUrl}/#profilepage`,
          "url": siteUrl,
          "name": fullTitle,
          "isPartOf": { "@id": `${siteUrl}/#website` },
          "mainEntity": {
            "@type": "Person",
            "@id": `${siteUrl}/#person`,
            "name": "Robert Lora",
            "givenName": "Robert",
            "familyName": "Lora",
            "jobTitle": "Director of SEO",
            "worksFor": {
              "@type": "Organization",
              "name": "uSERP",
              "url": "https://userp.io"
            },
            "url": siteUrl,
            "email": "mailto:rjlora@gmail.com",
            "sameAs": [
              "https://linkedin.com/in/robert-john-lora",
              "https://github.com/RobertJLora"
            ],
            "knowsAbout": [
              "Search Engine Optimization",
              "Link Building",
              "B2B SaaS SEO",
              "AI Search Optimization",
              "Generative Engine Optimization"
            ],
            "description": "Director of SEO at uSERP. Former fraud analyst turned SEO strategist with 300%+ traffic growth for B2B SaaS companies."
          }
        }] : [{
          "@type": "WebPage",
          "@id": `${pageUrl}#webpage`,
          "url": pageUrl,
          "name": fullTitle,
          "description": pageDescription,
          "isPartOf": { "@id": `${siteUrl}/#website` },
          "about": { "@id": `${siteUrl}/#person` }
        }])
      ]
    })} />

    <!-- Runs before paint: marks JavaScript as on and applies the theme without a flash.
         The stored value keeps the old site's key and values so returning visitors keep their choice. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        d.classList.add('js');
        var s = null;
        try { s = localStorage.getItem('theme'); } catch (e) {}
        var day = s === 'light' || (s !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
        d.setAttribute('data-theme', day ? 'day' : 'night');
        if (!day) d.classList.add('dark');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#content">skip to content</a>

    <div class="window">
      <header class="titlebar">
        <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
        <nav class="tabs" aria-label="sections">
          {tabs.map((t) => (
            <a class="tab" href={t.href} aria-current={t.id === activeTab ? 'page' : undefined}>{t.id}</a>
          ))}
        </nav>
      </header>

      <main id="content" class:list={['pane', { 'is-game': game }]} tabindex="-1">
        <slot />
      </main>

      <div class="dock">
        <section class="out" id="out" aria-label="command output">
          <div class="out-head">
            <p class="echo" id="out-echo" aria-hidden="true"></p>
            <button class="out-close" id="out-close" type="button" hidden>close<span class="sr-only"> output</span></button>
          </div>
          <div class="out-body" id="out-body" aria-live="polite"></div>
        </section>

        <footer class="bar">
          <a class="seg seg-name" href="/">robert lora</a>
          <button class="seg seg-term" id="term-toggle" type="button" aria-expanded="false" aria-controls="prompt">
            <span aria-hidden="true">&gt;_</span><span class="sr-only">open the command prompt</span>
          </button>
          <span class="seg seg-path">{cwd}</span>
          <form class="prompt" id="prompt" autocomplete="off">
            <label for="cmd" class="ps1"><span class="cwd">{cwd}</span><span class="chev" aria-hidden="true"></span><span class="sr-only">type a command or a question</span></label>
            <input id="cmd" name="cmd" type="text" enterkeyhint="go" autocapitalize="off" autocorrect="off" spellcheck="false" placeholder="try: work, contact, help" />
          </form>
          <span class="seg seg-clock">málaga <time id="clock" class="clock-time"></time></span>
          <button class="seg seg-theme" id="theme-toggle" type="button" aria-label="switch theme">
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
            <span class="theme-label" aria-hidden="true"></span>
          </button>
          <a class="seg seg-mail" href={`mailto:${EMAIL}`}>email me</a>
          <button class="seg seg-copy" type="button" data-copy-email>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>
            <span class="copy-label">copy</span><span class="sr-only"> email address</span>
          </button>
        </footer>
      </div>
    </div>

    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <script>
      import '../scripts/terminal';
    </script>
  </body>
</html>
