---
import Layout from '../layouts/Layout.astro';

const tabs = [
  ['about', '/'], ['work', '/case-studies/'], ['builds', '/builds/'], ['umbra', '/umbra/'],
  ['play', '/play/'], ['notes', '/resources/'], ['contact', '/quick-links/'],
];
---

<Layout
  title="Page Not Found"
  description="This page doesn't exist, but don't worry. Explore Robert Lora's notes on SEO, AI resources, and case studies."
  currentSlug="404"
  noindex={true}
>
  <p class="echo" aria-hidden="true"><span class="cwd">~</span><span class="chev"></span><span class="cmd" data-missing>this-page</span></p>
  <p class="err">zsh: command not found: <span data-missing>this-page</span></p>
  <h1 class="page-title">page not found</h1>
  <p class="lede">looks like this page wandered off. the link might be broken, or the page was moved somewhere else.</p>
  <nav aria-label="sections">
    <ul class="tab-links">
      {tabs.map(([label, href]) => <li><a class="chip" href={href}>{label}</a></li>)}
    </ul>
  </nav>

  <script>
    if (location.pathname !== '/404.html' && location.pathname !== '/404/') {
      document.querySelectorAll('[data-missing]').forEach((n) => { n.textContent = location.pathname; });
    }
  </script>
</Layout>
