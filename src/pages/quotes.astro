---
import Layout from '../layouts/Layout.astro';
import groups from '../data/quotes.json';
---

<Layout
  title="Quotes"
  description="Stoic wisdom, action-oriented mantras, and growth mindset quotes. The words Robert Lora returns to for motivation and perspective."
  currentSlug="quotes"
>
  <p class="echo" aria-hidden="true"><span class="cwd">~/notes</span><span class="chev"></span><span class="cmd">cat quotes.txt</span></p>
  <nav class="switch" aria-label="notes">
    <a href="/resources/">resources</a>
    <a href="/quotes/" aria-current="page">quotes</a>
  </nav>
  <div class="quotes-head">
    <h1 class="page-title">quotes</h1>
    <button class="btn" id="shuffle-quote" type="button" data-js-only hidden>random quote</button>
  </div>
  <p class="lede">words I come back to.</p>

  {groups.map((g) => (
    <section class="quote-group">
      <h2>{g.group}</h2>
      {g.quotes.map((q) => (
        <figure class="quote">
          <blockquote>"{q.text}"</blockquote>
          <figcaption>{q.by}</figcaption>
        </figure>
      ))}
    </section>
  ))}

  <script>
    const quotes = [...document.querySelectorAll<HTMLElement>('.quote')];
    let last = -1;
    document.getElementById('shuffle-quote')?.addEventListener('click', () => {
      let i = last;
      while (quotes.length > 1 && i === last) i = Math.floor(Math.random() * quotes.length);
      last = i;
      quotes.forEach((q) => q.classList.remove('is-picked'));
      const q = quotes[i];
      q.classList.add('is-picked');
      const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      q.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'center' });
    });
  </script>
</Layout>
