---
import Layout from '../../layouts/Layout.astro';
import GameFrame from '../../components/GameFrame.astro';
---

<Layout
  title="SERPent"
  description="A snake game for SEOs. Eat, grow, rank. Unlockable skins, achievements, combo scoring."
  currentSlug="play"
>
  <div class="serpent">
    <GameFrame cmd="serpent" title="serpent" lede="snake for people who check rankings too often. eat, grow, rank.">
      <Fragment slot="hud">
        <span>score <b id="sg-score">0</b></span>
        <span>best <b id="sg-best">0</b></span>
        <span id="sg-combo-wrap">combo <b id="sg-combo">-</b></span>
        <span>speed <b id="sg-speed">1</b></span>
      </Fragment>
      <canvas id="sg-canvas" width="400" height="400" aria-label="snake board"></canvas>
      <div id="sg-overlay" class="game-overlay"></div>
      <p id="sg-toast" class="sg-toast" role="status" hidden></p>
      <Fragment slot="keys">
        <kbd>arrows</kbd> or <kbd>wasd</kbd> steer, <kbd>space</kbd> start and pause, <kbd>m</kbd> music. on a phone, swipe the board.
      </Fragment>
    </GameFrame>

    <div class="sg-dpad" aria-label="touch controls">
      <button class="game-btn" data-dir="up" aria-label="up">&uarr;</button>
      <button class="game-btn" data-dir="left" aria-label="left">&larr;</button>
      <button class="game-btn" id="sg-pad-mid">start</button>
      <button class="game-btn" data-dir="right" aria-label="right">&rarr;</button>
      <button class="game-btn" data-dir="down" aria-label="down">&darr;</button>
    </div>

    <p class="sg-skins" id="sg-skins"></p>

    <div class="sg-actions">
      <button class="game-btn" id="sg-stats-btn" aria-expanded="false" aria-controls="sg-stats">stats</button>
      <button class="game-btn" id="sg-ach-btn" aria-expanded="false" aria-controls="sg-ach">achievements</button>
      <button class="game-btn" id="sg-music-btn" aria-pressed="false">music off</button>
    </div>

    <section id="sg-stats" class="sg-panel" hidden></section>
    <section id="sg-ach" class="sg-panel" hidden></section>
  </div>

  <style>
    .serpent :global(.game-board) { max-inline-size: 32rem; }
    .serpent :global(.game-board canvas) { aspect-ratio: 1; touch-action: none; }
    .serpent :global(.game-overlay p) { margin: 0; }
    .serpent :global(.sg-rank) { display: grid; gap: 0.3rem; inline-size: 12rem; font-size: var(--fs-small); color: var(--subtle); text-align: start; }
    .serpent :global(.sg-rank div) { display: grid; grid-template-columns: 4ch 1fr; align-items: center; gap: 1ch; }
    .serpent :global(.sg-rank i) { display: block; block-size: 0.55rem; background: var(--hl); border-radius: 1px; }
    .serpent :global(.sg-rank .you) { color: var(--fg); }
    .serpent :global(.sg-rank .you i) { background: var(--t-gold); }

    .sg-toast {
      position: absolute; inset-block-start: 0.75rem; inset-inline: 0.75rem; margin: 0; z-index: 2;
      background: var(--base); border: 1px solid var(--hl); border-radius: 4px;
      padding: 0.4rem 0.7rem; font-size: var(--fs-small); color: var(--subtle); text-align: center;
    }
    .sg-toast :global(b) { color: var(--t-gold); font-weight: 650; }

    .sg-dpad {
      display: none; grid-template-columns: repeat(3, 3.25rem); grid-template-rows: repeat(3, 2.6rem);
      gap: 0.35rem; justify-content: center; margin-block-start: 0.9rem; max-inline-size: 32rem;
    }
    .sg-dpad .game-btn { padding: 0; font-size: 1.1rem; touch-action: manipulation; }
    .sg-dpad [data-dir="up"] { grid-area: 1 / 2; }
    .sg-dpad [data-dir="left"] { grid-area: 2 / 1; }
    .sg-dpad #sg-pad-mid { grid-area: 2 / 2; font-size: 0.75rem; }
    .sg-dpad [data-dir="right"] { grid-area: 2 / 3; }
    .sg-dpad [data-dir="down"] { grid-area: 3 / 2; }
    @media (max-width: 40rem), (pointer: coarse) {
      .sg-dpad { display: grid; }
      /* the key legend is for keyboards; on a phone the d-pad sits right under the board */
      .serpent :global(.game-keys) { display: none; }
    }

    .sg-skins { font-size: var(--fs-small); color: var(--subtle); margin: 1rem 0 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1.5ch; align-items: baseline; }
    .sg-skins :global(button) {
      font: inherit; background: none; border: 0; padding: 0.2rem 0; cursor: pointer; color: var(--c);
      border-block-end: 1px solid transparent;
    }
    .sg-skins :global(button[aria-pressed="true"]) { border-block-end-color: currentColor; font-weight: 650; }
    .sg-skins :global(button:disabled) { color: var(--subtle); opacity: 0.6; cursor: default; }

    .sg-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-block-start: 0.75rem; }
    .sg-panel { margin-block-start: 1.5rem; max-inline-size: 40rem; font-size: 0.9rem; }
    .sg-panel :global(.echo) { margin-block-start: 0; }
    .sg-panel :global(.kv > div) { grid-template-columns: 16ch minmax(0, 1fr); padding-block: 0.1rem; }
    .sg-panel :global(.kv .off dt), .sg-panel :global(.kv .off dd) { color: var(--subtle); font-weight: 400; }
    .sg-panel :global(.kv .num) { color: var(--t-gold); }
    @media (max-width: 40rem) {
      .sg-panel :global(.kv > div) { grid-template-columns: 14ch minmax(0, 1fr); }
    }
  </style>

  <script>
    import { palette, onTheme, reduceMotion, store, type Palette } from '../../scripts/game-kit';

    type Pt = { x: number; y: number };
    type Accent = 'foam' | 'iris' | 'gold' | 'rose' | 'love' | 'pine';

    const GRID = 20, CELL = 20, SIZE = GRID * CELL;
    const COMBO_WINDOW = 3000;
    const DIRS: Record<string, Pt> = { up: { x: 0, y: -1 }, down: { x: 0, y: 1 }, left: { x: -1, y: 0 }, right: { x: 1, y: 0 } };
    const KEYS: Record<string, string> = {
      ArrowUp: 'up', w: 'up', ArrowDown: 'down', s: 'down', ArrowLeft: 'left', a: 'left', ArrowRight: 'right', d: 'right',
    };

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const canvas = $<HTMLCanvasElement>('sg-canvas');
    const ctx = canvas.getContext('2d')!;
    const board = canvas.parentElement as HTMLElement;
    const overlay = $('sg-overlay');
    const toast = $('sg-toast');
    const padMid = $('sg-pad-mid');
    const statsPanel = $('sg-stats');
    const achPanel = $('sg-ach');
    const statsBtn = $('sg-stats-btn');
    const achBtn = $('sg-ach-btn');
    const musicBtn = $('sg-music-btn');
    const hud = { score: $('sg-score'), best: $('sg-best'), combo: $('sg-combo'), comboWrap: $('sg-combo-wrap'), speed: $('sg-speed') };

    let p: Palette = palette();
    let font = getComputedStyle(document.body).fontFamily;
    onTheme((next) => { p = next; });

    /* ---------- skins: rose pine accents, unlocked by playing ---------- */
    type Stats = typeof defaults;
    const SKINS: { key: string; snake: Accent | 'prism'; food: Accent | 'fg'; req?: string; ok?: (s: Stats) => boolean }[] = [
      { key: 'foam', snake: 'foam', food: 'gold' },
      { key: 'iris', snake: 'iris', food: 'gold', req: 'score 30', ok: (s) => s.highScore >= 30 },
      { key: 'gold', snake: 'gold', food: 'love', req: 'score 50', ok: (s) => s.highScore >= 50 },
      { key: 'pine', snake: 'pine', food: 'gold', req: '25 games', ok: (s) => s.totalGames >= 25 },
      { key: 'love', snake: 'love', food: 'foam', req: '50 games', ok: (s) => s.totalGames >= 50 },
      { key: 'rose', snake: 'rose', food: 'iris', req: 'the code', ok: (s) => s.konami },
      { key: 'prism', snake: 'prism', food: 'fg', req: 'the code', ok: (s) => s.konami },
    ];
    const PRISM: Accent[] = ['love', 'gold', 'rose', 'foam', 'iris', 'pine'];
    const OLD_SKINS: Record<string, string> = { classic: 'foam', neon: 'iris', sunset: 'gold', arctic: 'pine', blood: 'love', matrix: 'rose', party: 'prism' };

    /* ---------- achievements ---------- */
    const ACH: Record<string, [string, string]> = {
      firstBlood: ['indexed', 'eat your first keyword'],
      combo5: ['combo master', 'hit a 5x combo'],
      combo10: ['unstoppable', 'hit a 10x combo'],
      score25: ['page two', 'score 25'],
      score50: ['page one', 'score 50'],
      score100: ['position zero', 'score 100'],
      games10: ['getting hooked', 'play 10 games'],
      games50: ['dedicated', 'play 50 games'],
      games100: ['obsessed', 'play 100 games'],
      nightOwl: ['night owl', 'play between midnight and 5am'],
      speedDemon: ['speed demon', 'reach max speed'],
      konami: ['↑↑↓↓←→←→ba', 'you know the code'],
      streak7: ['weekly warrior', 'play 7 days in a row'],
      wallHugger: ['wall hugger', 'hit a wall 10 times'],
      selfDestruct: ['self destruct', 'bite yourself 10 times'],
    };
    const ACH_TOTAL = Object.keys(ACH).length;

    /* ---------- persistence (migrates the old snakeUltimate key once) ---------- */
    const STATS_KEY = 'rjl-serpent-stats';
    const defaults = {
      totalGames: 0, totalScore: 0, highScore: 0, totalMoves: 0, deathsByWall: 0, deathsBySelf: 0,
      longestCombo: 0, totalFoodEaten: 0, currentStreak: 0, longestStreak: 0, lastPlayDate: '',
      konami: false, achievements: {} as Record<string, boolean>, milestonesShown: {} as Record<string, boolean>,
      activeTheme: 'foam',
    };
    const stats: Stats = { ...defaults, ...store.get<Partial<Stats> | null>(STATS_KEY, null) ?? store.get<Partial<Stats>>('snakeUltimate', {}) };
    stats.activeTheme = OLD_SKINS[stats.activeTheme] ?? stats.activeTheme;
    const save = () => store.set(STATS_KEY, stats);
    const skinUnlocked = (s: (typeof SKINS)[number]) => !s.ok || s.ok(stats);
    let skin = SKINS.find((s) => s.key === stats.activeTheme && skinUnlocked(s)) ?? SKINS[0];

    /* ---------- streak ---------- */
    const dayStr = (d: Date) => `${d.getFullYear()}${String(d.getMonth() + 1).padStart(2, '0')}${String(d.getDate()).padStart(2, '0')}`;
    function updateStreak() {
      const today = dayStr(new Date());
      if (stats.lastPlayDate === today) return;
      const y = new Date(); y.setDate(y.getDate() - 1);
      stats.currentStreak = stats.lastPlayDate === dayStr(y) ? stats.currentStreak + 1 : 1;
      stats.lastPlayDate = today;
      stats.longestStreak = Math.max(stats.longestStreak, stats.currentStreak);
      save();
    }
    function daysSinceLastPlay() {
      const d = stats.lastPlayDate;
      if (d.length !== 8) return 0;
      return Math.floor((Date.now() - new Date(+d.slice(0, 4), +d.slice(4, 6) - 1, +d.slice(6, 8)).getTime()) / 86400000);
    }

    /* ---------- audio: everything is synthesized, nothing loads ---------- */
    let audio: AudioContext | null = null;
    function unlockAudio() {
      if (!audio) { try { audio = new AudioContext(); } catch { /* no audio */ } }
      if (audio?.state === 'suspended') audio.resume();
    }
    function tone(type: OscillatorType, f0: number, f1: number, gain: number, dur: number, delay = 0) {
      if (!audio) return;
      const t = audio.currentTime + delay;
      const o = audio.createOscillator(), g = audio.createGain();
      o.type = type;
      o.frequency.setValueAtTime(f0, t);
      if (f1 !== f0) o.frequency.exponentialRampToValueAtTime(f1, t + dur * 0.85);
      g.gain.setValueAtTime(gain, t);
      g.gain.exponentialRampToValueAtTime(0.001, t + dur);
      o.connect(g).connect(audio.destination);
      o.start(t); o.stop(t + dur);
    }
    const sfx = {
      eat: (combo: number) => tone('triangle', 400 + combo * 50, 800 + combo * 50, 0.15, 0.12),
      die: () => tone('sawtooth', 440, 50, 0.18, 0.52),
      turn: () => tone('square', 800, 800, 0.03, 0.03),
      chord: (notes: number[], type: OscillatorType, step: number, len: number) => notes.forEach((f, i) => tone(type, f, f, 0.1, len, i * step)),
    };

    // ambient bed: detuned saw pad under a slow lowpass sweep, filtered noise, sparse pentatonic plucks
    const music = {
      nodes: [] as AudioScheduledSourceNode[], master: null as GainNode | null, timer: 0,
      start() {
        unlockAudio();
        if (!audio || this.master) return;
        const a = audio, t = a.currentTime;
        const master = (this.master = a.createGain());
        master.gain.setValueAtTime(0, t);
        master.gain.linearRampToValueAtTime(1, t + 2);
        master.connect(a.destination);
        const lp = a.createBiquadFilter();
        lp.type = 'lowpass'; lp.frequency.value = 300; lp.connect(master);
        const lfo = a.createOscillator(), lfoGain = a.createGain();
        lfo.frequency.value = 0.08; lfoGain.gain.value = 150;
        lfo.connect(lfoGain).connect(lp.frequency);
        this.nodes.push(lfo);
        for (const [detune, vol] of [[-10, 0.06], [10, 0.04]]) {
          const o = a.createOscillator(), g = a.createGain();
          o.type = 'sawtooth'; o.frequency.value = 55; o.detune.value = detune; g.gain.value = vol;
          o.connect(g).connect(lp);
          this.nodes.push(o);
        }
        const buf = a.createBuffer(1, a.sampleRate * 2, a.sampleRate);
        buf.getChannelData(0).forEach((_, i, d) => { d[i] = Math.random() * 2 - 1; });
        const noise = a.createBufferSource(), bp = a.createBiquadFilter(), ng = a.createGain();
        noise.buffer = buf; noise.loop = true; bp.type = 'bandpass'; bp.frequency.value = 2000; bp.Q.value = 0.5; ng.gain.value = 0.02;
        noise.connect(bp).connect(ng).connect(master);
        this.nodes.push(noise);
        this.nodes.forEach((n) => n.start());
        const notes = [110, 130.81, 146.83, 164.81, 196, 220, 261.63, 293.66, 329.63];
        const pluck = () => {
          if (!this.master || !audio) return;
          const now = audio.currentTime, o = audio.createOscillator(), g = audio.createGain();
          o.type = 'triangle'; o.frequency.value = notes[Math.floor(Math.random() * notes.length)];
          g.gain.setValueAtTime(0, now);
          g.gain.linearRampToValueAtTime(0.04, now + 0.3);
          g.gain.exponentialRampToValueAtTime(0.0005, now + 1.5);
          o.connect(g).connect(this.master);
          o.start(now); o.stop(now + 1.6);
          this.timer = window.setTimeout(pluck, 2000 + Math.random() * 4000);
        };
        this.timer = window.setTimeout(pluck, 1000);
      },
      stop() {
        if (!audio || !this.master) return;
        const master = this.master, nodes = this.nodes;
        this.master = null; this.nodes = [];
        clearTimeout(this.timer);
        master.gain.linearRampToValueAtTime(0, audio.currentTime + 1);
        setTimeout(() => { nodes.forEach((n) => n.stop()); master.disconnect(); }, 1100);
      },
      toggle() {
        if (this.master) this.stop(); else this.start();
        musicBtn.textContent = this.master ? 'music on' : 'music off';
        musicBtn.setAttribute('aria-pressed', String(!!this.master));
      },
    };

    /* ---------- juice: pixel particles, floating text, shake, hitstop ---------- */
    type Particle = { x: number; y: number; vx: number; vy: number; life: number; color: string; size: number };
    type Floater = { text: string; x: number; y: number; vy: number; life: number; color: string; size: number };
    const particles: Particle[] = [];
    const floaters: Floater[] = [];
    let shake = 0, freeze = 0;
    function burst(x: number, y: number, color: string, count: number, speed: number) {
      if (reduceMotion()) return;
      for (let i = 0; i < count; i++) {
        const a = Math.random() * Math.PI * 2, s = speed * (0.5 + Math.random());
        particles.push({ x, y, vx: Math.cos(a) * s, vy: Math.sin(a) * s, life: 0.3 + Math.random() * 0.4, color, size: 2 + Math.floor(Math.random() * 3) });
      }
    }
    function float(text: string, x: number, y: number, color: string, size: number) {
      if (!reduceMotion()) floaters.push({ text, x, y, vy: -70, life: 0.8, color, size });
    }
    const kick = (amount: number) => { if (!reduceMotion()) shake = Math.min(1, shake + amount); };

    /* ---------- game state ---------- */
    type State = {
      snake: Pt[]; dir: Pt; food: Pt; score: number; combo: number; bestCombo: number; comboTimer: number;
      started: boolean; paused: boolean; over: boolean; death: 'wall' | 'self' | null;
    };
    let state: State;
    let queued: Pt[] = [];
    let lastFoodTime = 0, acc = 0, clock = 0, diedAt = 0;

    function fresh(): State {
      const c = GRID / 2;
      const snake = [{ x: c, y: c }, { x: c - 1, y: c }, { x: c - 2, y: c }];
      return { snake, dir: DIRS.right, food: spawnFood(snake), score: 0, combo: 0, bestCombo: 0, comboTimer: 0, started: false, paused: false, over: false, death: null };
    }
    function spawnFood(snake: Pt[]): Pt {
      if (snake.length >= GRID * GRID) return { x: 0, y: 0 };
      let pos: Pt;
      do pos = { x: Math.floor(Math.random() * GRID), y: Math.floor(Math.random() * GRID) };
      while (snake.some((s) => s.x === pos.x && s.y === pos.y));
      return pos;
    }
    const interval = () => Math.max(70, 120 - state.score * 3);
    const speedLevel = () => Math.min(20, Math.floor((120 - interval()) / 2.5) + 1);
    const playing = () => state.started && !state.paused && !state.over;
    const center = (pt: Pt) => [pt.x * CELL + CELL / 2, pt.y * CELL + CELL / 2] as const;

    function tick() {
      const next = queued.shift();
      if (next && (next.x + state.dir.x !== 0 || next.y + state.dir.y !== 0)) state.dir = next;
      const head = { x: state.snake[0].x + state.dir.x, y: state.snake[0].y + state.dir.y };
      const hit = head.x < 0 || head.x >= GRID || head.y < 0 || head.y >= GRID ? 'wall'
        : state.snake.slice(0, -1).some((s) => s.x === head.x && s.y === head.y) ? 'self' : null;
      if (hit) return die(hit);
      const ate = head.x === state.food.x && head.y === state.food.y;
      state.snake.unshift(head);
      if (!ate) state.snake.pop();
      stats.totalMoves++;
      if (ate) eat();
      else if (state.comboTimer > 0 && (state.comboTimer -= interval()) <= 0) { state.combo = 0; state.comboTimer = 0; }
    }

    function eat() {
      const now = performance.now();
      state.combo = lastFoodTime && now - lastFoodTime < COMBO_WINDOW ? state.combo + 1 : 1;
      lastFoodTime = now;
      state.comboTimer = COMBO_WINDOW;
      state.score += state.combo;
      state.food = spawnFood(state.snake);
      stats.totalFoodEaten++;

      const [hx, hy] = center(state.snake[0]);
      burst(hx, hy, p[skin.food], 8, 120);
      kick(0.15);
      freeze = 2;
      sfx.eat(state.combo);
      float(`+${state.combo}`, hx, hy - 10, state.combo > 1 ? p.gold : p.fg, state.combo > 1 ? 16 : 13);
      if (state.combo % 5 === 0) {
        burst(SIZE / 2, SIZE / 2, p.gold, 16, 150);
        kick(0.35);
        freeze = 4;
        sfx.chord([523, 659, 784], 'square', 0.08, 0.15);
        float(`combo x${state.combo}`, SIZE / 2, SIZE / 2, p.gold, 20);
      }
      state.bestCombo = Math.max(state.bestCombo, state.combo);
      stats.longestCombo = Math.max(stats.longestCombo, state.combo);
      if (state.combo === 5) milestone('combo5msg', "now you're cooking.");

      if (stats.totalFoodEaten === 1) award('firstBlood');
      if (state.combo >= 5) award('combo5');
      if (state.combo >= 10) award('combo10');
      if (state.score >= 25) award('score25');
      if (state.score >= 50) award('score50');
      if (state.score >= 100) award('score100');
      if (interval() <= 70) award('speedDemon');
    }

    function die(type: 'wall' | 'self') {
      state.over = true;
      state.death = type;
      diedAt = clock;
      const [hx, hy] = center(state.snake[0]);
      burst(hx, hy, snakeColor(0), 20, 200);
      kick(0.8);
      freeze = 8;
      sfx.die();

      if (type === 'wall') stats.deathsByWall++; else stats.deathsBySelf++;
      if (stats.deathsByWall >= 10) award('wallHugger');
      if (stats.deathsBySelf >= 10) award('selfDestruct');
      stats.totalGames++;
      stats.totalScore += state.score;
      updateStreak();
      const prevHigh = stats.highScore;
      const best = state.score > prevHigh;
      if (best) { stats.highScore = state.score; sfx.chord([587, 740, 880], 'triangle', 0.12, 0.25); }
      if (stats.totalGames >= 10) award('games10');
      if (stats.totalGames >= 50) award('games50');
      if (stats.totalGames >= 100) award('games100');
      if (stats.currentStreak >= 7) award('streak7');

      if (stats.totalGames === 1) milestone('game1', 'every journey starts somewhere.');
      else if (stats.totalGames === 10) milestone('game10', "you're getting the hang of this.");
      else if (stats.totalGames === 50) milestone('game50', "50 games. you could've learned 3 chords on guitar by now. this is better.");
      else if (stats.totalGames === 100) milestone('game100', 'triple digits. respect.');
      else if (prevHigh > 0 && state.score >= prevHigh * 2) milestone('double', "you just doubled your best. that's not luck.");
      save();
      renderSkins();
      updateHud();
      setTimeout(() => showOver(best), reduceMotion() ? 0 : 550);
    }

    /* ---------- toasts: achievements and milestones share one queue ---------- */
    const toasts: string[] = [];
    let toastBusy = false;
    function award(key: string) {
      if (stats.achievements[key]) return;
      stats.achievements[key] = true;
      save();
      pushToast(`unlocked <b>${ACH[key][0]}</b> &middot; ${ACH[key][1]}`);
    }
    function milestone(key: string, text: string) {
      if (stats.milestonesShown[key]) return;
      stats.milestonesShown[key] = true;
      save();
      pushToast(text);
    }
    function pushToast(html: string) {
      toasts.push(html);
      if (!toastBusy) nextToast();
    }
    function nextToast() {
      const html = toasts.shift();
      toastBusy = !!html;
      toast.hidden = !html;
      if (!html) return;
      toast.innerHTML = html;
      setTimeout(nextToast, 2600);
    }

    /* ---------- overlay ---------- */
    function quip(score: number) {
      if (score === 0) return 'crawl error.';
      if (score <= 10) return 'noindexed.';
      if (score <= 25) return 'page two. so close.';
      if (score <= 50) return 'indexed and climbing.';
      if (score <= 99) return 'top 10 material.';
      return 'position one.';
    }
    const achCount = () => Object.keys(stats.achievements).filter((k) => k in ACH).length;
    function showOverlay(html: string) {
      overlay.innerHTML = html;
      overlay.hidden = false;
      updateHud();
    }
    function showStart() {
      const record = stats.totalGames ? `best ${stats.highScore} &middot; ${achCount()}/${ACH_TOTAL} unlocked` : 'walls are a core update. avoid them.';
      showOverlay(`<p class="big">ready</p><p class="dim">${record}</p><button class="game-btn primary" data-act="go">start</button><p class="dim">space or tap</p>`);
    }
    function showOver(best: boolean) {
      if (!state.over) return;
      const s = state.score, high = Math.max(stats.highScore, s, 1);
      const you = Math.max(20, Math.min(85, Math.round((s / high) * 85)));
      const bar = (label: string, w: number, cls = '') => `<div class="${cls}"><span>${label}</span><i style="inline-size:${w}%"></i></div>`;
      showOverlay(
        `<p class="dim">${state.death === 'wall' ? 'hit a wall' : 'bit yourself'}</p>` +
        `<p class="big">${s}</p>` +
        (best ? '<p class="game-ok">new best</p>' : '') +
        `<div class="sg-rank" aria-hidden="true">${bar('#1', Math.min(100, you + 15))}${bar('you', you, 'you')}${bar('#3', Math.max(15, you - 20))}</div>` +
        `<p class="dim">${quip(s)}${state.bestCombo >= 2 ? ` best combo x${state.bestCombo}.` : ''}</p>` +
        '<button class="game-btn primary" data-act="go">again</button><p class="dim">space to restart</p>',
      );
    }

    /* ---------- controls ---------- */
    function steer(name: string) {
      if (!playing()) return;
      const d = DIRS[name], last = queued[queued.length - 1] ?? state.dir;
      if (queued.length >= 2 || (d.x === last.x && d.y === last.y)) return;
      queued.push(d);
      // a turn late in the tick lands now, which makes tight corners feel responsive
      if (queued.length === 1 && acc > interval() * 0.6) acc = interval();
      sfx.turn();
    }
    function go() {
      unlockAudio();
      if (!state.started || state.over) {
        if (state.over) state = fresh();
        queued = []; particles.length = 0; floaters.length = 0; shake = 0; freeze = 0; lastFoodTime = 0; acc = 0;
        state.started = true;
        overlay.hidden = true;
        const h = new Date().getHours();
        if (h < 5) award('nightOwl');
      } else {
        state.paused = !state.paused;
        if (state.paused) showOverlay('<p class="big">paused</p><button class="game-btn primary" data-act="go">resume</button><p class="dim">p or space</p>');
        else { overlay.hidden = true; acc = 0; }
      }
      updateHud();
    }
    const pause = () => { if (playing()) go(); };

    const konami = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
    let konamiAt = 0;
    function checkKonami(key: string) {
      konamiAt = key === konami[konamiAt] ? konamiAt + 1 : key === konami[0] ? 1 : 0;
      if (konamiAt < konami.length) return;
      konamiAt = 0;
      if (stats.konami) return;
      stats.konami = true;
      award('konami');
      burst(SIZE / 2, SIZE / 2, p.iris, 80, 200);
      kick(0.5);
      sfx.chord([523, 659, 784], 'square', 0.08, 0.15);
      renderSkins();
    }

    // terminal.ts never grabs keys on game pages, and the prompt input stops its own key events,
    // so this listener only sees keys typed outside text fields. Space on a focused button is the
    // game's space too, so a clicked start or skin button can't swallow it.
    document.addEventListener('keydown', (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey || e.isComposing) return;
      if ((e.target as HTMLElement).closest?.('input, textarea, select, [contenteditable="true"]')) return;
      const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
      checkKonami(key);
      const dir = KEYS[key];
      if (dir) {
        if (playing()) { e.preventDefault(); steer(dir); }
      } else if (key === ' ') {
        e.preventDefault();
        go();
      } else if (key === 'p') pause();
      else if (key === 'm') music.toggle();
    });

    overlay.addEventListener('click', () => go());
    document.addEventListener('visibilitychange', () => { if (document.hidden) pause(); });

    // swipes on the board steer; each 24px of travel counts, so one long drag can turn twice
    let touch: Pt | null = null;
    board.addEventListener('touchstart', (e) => {
      if ((e.target as Element).closest('button')) return;
      unlockAudio();
      touch = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      if (playing()) e.preventDefault();
    }, { passive: false });
    board.addEventListener('touchmove', (e) => {
      if (!touch || !playing()) return;
      e.preventDefault();
      const t = e.touches[0], dx = t.clientX - touch.x, dy = t.clientY - touch.y;
      if (Math.max(Math.abs(dx), Math.abs(dy)) < 24) return;
      steer(Math.abs(dx) > Math.abs(dy) ? (dx > 0 ? 'right' : 'left') : (dy > 0 ? 'down' : 'up'));
      touch = { x: t.clientX, y: t.clientY };
    }, { passive: false });
    board.addEventListener('touchend', () => { touch = null; });

    document.querySelectorAll<HTMLElement>('.sg-dpad [data-dir]').forEach((b) => {
      b.addEventListener('pointerdown', (e) => { e.preventDefault(); unlockAudio(); steer(b.dataset.dir!); });
    });
    padMid.addEventListener('click', () => go());
    musicBtn.addEventListener('click', () => music.toggle());

    /* ---------- skins, stats, achievements ---------- */
    function renderSkins() {
      const el = $('sg-skins');
      el.innerHTML = '<span>skin</span>' + SKINS.map((s) => {
        const open = skinUnlocked(s);
        const color = s.snake === 'prism' ? 'var(--fg)' : `var(--${s.snake === 'pine' ? 'p2' : 't-' + s.snake})`;
        return `<button data-skin="${s.key}" style="--c:${color}" aria-pressed="${s === skin}"${open ? '' : ` disabled title="unlock: ${s.req}"`}>${open ? s.key : `${s.key} (${s.req})`}</button>`;
      }).join('');
    }
    $('sg-skins').addEventListener('click', (e) => {
      const key = (e.target as HTMLElement).closest<HTMLElement>('[data-skin]')?.dataset.skin;
      const next = SKINS.find((s) => s.key === key);
      if (!next || !skinUnlocked(next)) return;
      skin = next;
      stats.activeTheme = next.key;
      save();
      renderSkins();
    });

    const row = (k: string, v: string | number, cls = '') => `<div class="${cls}"><dt>${k}</dt><dd>${v}</dd></div>`;
    const echo = (cmd: string) => `<p class="echo" aria-hidden="true"><span class="cwd">~/play/serpent</span><span class="chev"></span><span class="cmd">${cmd}</span></p>`;
    function renderStats() {
      const n = (v: number) => `<span class="num">${v}</span>`;
      statsPanel.innerHTML = echo('cat stats') + '<dl class="kv">' +
        row('games', n(stats.totalGames)) + row('high score', n(stats.highScore)) + row('total score', n(stats.totalScore)) +
        row('food eaten', n(stats.totalFoodEaten)) + row('longest combo', n(stats.longestCombo)) + row('moves', n(stats.totalMoves)) +
        row('wall deaths', n(stats.deathsByWall)) + row('self deaths', n(stats.deathsBySelf)) +
        row('streak', `${n(daysSinceLastPlay() <= 1 ? stats.currentStreak : 0)} days`) + row('best streak', `${n(stats.longestStreak)} days`) + '</dl>';
    }
    function renderAch() {
      achPanel.innerHTML = echo(`ls achievements  # ${achCount()}/${ACH_TOTAL}`) + '<dl class="kv">' +
        Object.entries(ACH).map(([k, [name, desc]]) => row(name, (stats.achievements[k] ? '[x] ' : '[ ] ') + desc, stats.achievements[k] ? '' : 'off')).join('') + '</dl>';
    }
    function togglePanel(btn: HTMLElement, panel: HTMLElement, other: HTMLElement, otherBtn: HTMLElement, render: () => void) {
      render();
      panel.hidden = !panel.hidden;
      other.hidden = true;
      btn.setAttribute('aria-expanded', String(!panel.hidden));
      otherBtn.setAttribute('aria-expanded', 'false');
    }
    statsBtn.addEventListener('click', () => togglePanel(statsBtn, statsPanel, achPanel, achBtn, renderStats));
    achBtn.addEventListener('click', () => togglePanel(achBtn, achPanel, statsPanel, statsBtn, renderAch));

    function updateHud() {
      hud.score.textContent = String(state.score);
      hud.best.textContent = String(stats.highScore);
      hud.combo.textContent = state.combo >= 2 ? `x${state.combo}` : '-';
      hud.comboWrap.classList.toggle('hot', state.combo >= 2);
      hud.speed.textContent = String(speedLevel());
      padMid.textContent = !state.started ? 'start' : state.over ? 'again' : state.paused ? 'resume' : 'pause';
    }

    /* ---------- rendering ---------- */
    let scale = 1;
    const dpr = () => window.devicePixelRatio || 1;
    new ResizeObserver(() => {
      const px = Math.round(canvas.clientWidth * dpr());
      if (px && px !== canvas.width) { canvas.width = canvas.height = px; }
      scale = canvas.width / SIZE;
      font = getComputedStyle(document.body).fontFamily;
    }).observe(canvas);

    function snakeColor(i: number) {
      if (state.over && i > 0) return p.unlit;
      if (state.over) return p.love;
      return skin.snake === 'prism' ? p[PRISM[(i + Math.floor(clock * 6)) % PRISM.length]] : p[skin.snake];
    }

    function render() {
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      let ox = 0, oy = 0;
      if (shake > 0.01) {
        const k = shake * shake * 6;
        ox = (Math.random() * 2 - 1) * k; oy = (Math.random() * 2 - 1) * k;
        shake *= 0.9;
      } else shake = 0;
      ctx.setTransform(scale, 0, 0, scale, ox * scale, oy * scale);

      ctx.fillStyle = p.base;
      ctx.fillRect(0, 0, SIZE, SIZE);
      // terminal cells: one faint dot per cell
      ctx.fillStyle = p.hl;
      for (let x = 0; x < GRID; x++) for (let y = 0; y < GRID; y++) ctx.fillRect(x * CELL + CELL / 2 - 1, y * CELL + CELL / 2 - 1, 2, 2);

      drawFood();
      drawSnake();

      for (const q of particles) {
        ctx.globalAlpha = Math.max(0, q.life / 0.7);
        ctx.fillStyle = q.color;
        ctx.fillRect(Math.round(q.x), Math.round(q.y), q.size, q.size);
      }
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      for (const f of floaters) {
        ctx.globalAlpha = Math.max(0, f.life / 0.8);
        ctx.fillStyle = f.color;
        ctx.font = `650 ${f.size}px ${font}`;
        ctx.fillText(f.text, f.x, f.y);
      }
      ctx.globalAlpha = 1;
    }

    function drawFood() {
      const { x, y } = state.food;
      const pulse = reduceMotion() ? 0 : Math.sin(clock * 5) * 1.25;
      const inset = 5 - pulse;
      ctx.fillStyle = p[skin.food];
      ctx.fillRect(x * CELL + inset, y * CELL + inset, CELL - inset * 2, CELL - inset * 2);
      if (!reduceMotion() && playing()) {
        // a ping ring that expands out of the food once a second
        const t = clock % 1.2;
        if (t < 0.6) {
          ctx.globalAlpha = 0.6 * (1 - t / 0.6);
          ctx.strokeStyle = p[skin.food];
          ctx.lineWidth = 1;
          const r = 4 + t * 16;
          ctx.strokeRect(x * CELL + CELL / 2 - r, y * CELL + CELL / 2 - r, r * 2, r * 2);
          ctx.globalAlpha = 1;
        }
      }
    }

    function drawSnake() {
      const s = state.snake, pad = 2, size = CELL - pad * 2;
      for (let i = s.length - 1; i >= 0; i--) {
        const seg = s[i];
        ctx.fillStyle = snakeColor(i);
        ctx.fillRect(seg.x * CELL + pad, seg.y * CELL + pad, size, size);
        // bridge the gap to the segment ahead so the body reads as one piece
        const ahead = s[i - 1];
        if (ahead) {
          const bx = Math.min(seg.x, ahead.x) * CELL + pad, by = Math.min(seg.y, ahead.y) * CELL + pad;
          ctx.fillRect(bx, by, seg.x !== ahead.x ? CELL + size : size, seg.y !== ahead.y ? CELL + size : size);
        }
      }
      // eyes look where the snake is going
      const h = s[0], d = state.dir;
      const cx = h.x * CELL + CELL / 2 + d.x * 3, cy = h.y * CELL + CELL / 2 + d.y * 3;
      ctx.fillStyle = p.base;
      ctx.fillRect(cx - 1 + d.y * 4, cy - 1 + d.x * 4, 3, 3);
      ctx.fillRect(cx - 1 - d.y * 4, cy - 1 - d.x * 4, 3, 3);
    }

    /* ---------- loop ---------- */
    let last = 0;
    function frame(ts: number) {
      const dt = Math.min(0.1, (ts - last) / 1000 || 0);
      last = ts;
      clock += dt;
      if (freeze > 0) freeze--;
      else if (playing()) {
        acc += dt * 1000;
        for (let n = 0; acc >= interval() && n < 3 && playing(); n++) {
          acc -= interval();
          tick();
          updateHud();
        }
      }
      for (let i = particles.length - 1; i >= 0; i--) {
        const q = particles[i];
        q.x += q.vx * dt; q.y += q.vy * dt; q.vx *= 0.96; q.vy *= 0.96; q.life -= dt;
        if (q.life <= 0) particles.splice(i, 1);
      }
      for (let i = floaters.length - 1; i >= 0; i--) {
        const f = floaters[i];
        f.y += f.vy * dt; f.vy *= 0.95; f.life -= dt;
        if (f.life <= 0) floaters.splice(i, 1);
      }
      render();
      requestAnimationFrame(frame);
    }

    state = fresh();
    if (daysSinceLastPlay() >= 30) milestone('return30', 'welcome back. the snake waited.');
    renderSkins();
    showStart();
    requestAnimationFrame((ts) => { last = ts; frame(ts); });
  </script>
</Layout>
