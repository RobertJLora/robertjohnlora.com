---
import Layout from '../../layouts/Layout.astro';
import GameFrame from '../../components/GameFrame.astro';
---

<Layout
  title="SEO Intuition Test"
  description="Which keyword gets searched more? Ten rounds of real, dated US search volumes. A quick game for search marketers."
  currentSlug="play"
>
  <GameFrame cmd="keywords" title="seo intuition test" lede="two keywords, one gets searched more. guess which. real us volumes, ten rounds.">
    <Fragment slot="hud">
      <span>round <b id="kw-round">0/10</b></span>
      <span>score <b id="kw-score">0</b></span>
      <span>streak <b id="kw-streak">0</b></span>
      <span>best <b id="kw-best">-</b></span>
    </Fragment>

    <div class="kw is-idle" id="kw">
      <div class="kw-picks">
        <button type="button" class="kw-pick" data-side="0" disabled><kbd>1</kbd><span class="kw-word">&nbsp;</span></button>
        <span class="kw-vs" aria-hidden="true">vs</span>
        <button type="button" class="kw-pick" data-side="1" disabled><kbd>2</kbd><span class="kw-word">&nbsp;</span></button>
      </div>
      <div class="kw-reveal" id="kw-reveal" hidden>
        <p class="kw-verdict" id="kw-verdict"></p>
        <div class="kw-rows" id="kw-rows"></div>
        <p class="kw-hint" id="kw-hint"></p>
        <button type="button" class="game-btn primary" id="kw-next">next</button>
      </div>
    </div>

    <div class="game-overlay" id="kw-start">
      <p class="big">higher or lower, but for google</p>
      <p class="dim">10 pairs from 40. trust your gut, then check the numbers.</p>
      <button type="button" class="game-btn primary" id="kw-go">start</button>
    </div>

    <div class="game-overlay" id="kw-end" hidden>
      <p class="big" id="kw-final"></p>
      <p id="kw-band"></p>
      <pre class="kw-marks" id="kw-marks" aria-hidden="true"></pre>
      <div class="kw-actions">
        <button type="button" class="game-btn primary" id="kw-again">play again</button>
        <button type="button" class="game-btn" id="kw-share">share</button>
      </div>
      <p class="dim" id="kw-foot"></p>
    </div>

    <Fragment slot="keys">
      <kbd>1</kbd> or <kbd>&larr;</kbd> left, <kbd>2</kbd> or <kbd>&rarr;</kbd> right, <kbd>enter</kbd> next
    </Fragment>
  </GameFrame>
</Layout>

<script>
  import data from '../../data/keyword-pairs.json';
  import { reduceMotion, store } from '../../scripts/game-kit';

  type Side = { keyword: string; volume: number; source: string };
  type Pair = { a: Side; b: Side; hint: string };

  const ROUNDS = 10;
  const BEST_KEY = 'rjl-keywords-best';
  const pairs = data.pairs as Pair[];

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const board = $('kw');
  const picks = [...board.querySelectorAll<HTMLButtonElement>('.kw-pick')];
  const reveal = $('kw-reveal');
  const rows = $('kw-rows');
  const nextBtn = $<HTMLButtonElement>('kw-next');
  const startEl = $('kw-start');
  const endEl = $('kw-end');
  const shareBtn = $<HTMLButtonElement>('kw-share');

  // "pulled 2026-10-02" becomes "oct 2026"; the source label follows whatever tool filled the data
  const pulled = new Date(data.pulled + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', year: 'numeric' }).toLowerCase();
  const sourceLabel = data.sources.map((s) => s.replace(/ US$/, '')).join(' + ');
  $('kw-foot').textContent = `monthly US searches, ${sourceLabel}, pulled ${pulled}`;

  let deck: Pair[] = [];
  let round = 0;
  let score = 0;
  let streak = 0;
  let shown: Side[] = [];
  let marks: boolean[] = [];
  let answered = false;
  let best = store.get<number | null>(BEST_KEY, null);

  const fmt = (n: number) => n.toLocaleString('en-US');

  function shuffle<T>(arr: T[]): T[] {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function hud() {
    $('kw-round').textContent = `${Math.min(round + 1, ROUNDS)}/${ROUNDS}`;
    $('kw-score').textContent = String(score);
    const s = $('kw-streak');
    s.textContent = String(streak);
    s.classList.toggle('hot', streak >= 3);
    $('kw-best').textContent = best == null ? '-' : `${best}/${ROUNDS}`;
  }

  function start() {
    // some keywords sit in two pairs; never show one twice in a game
    const seen = new Set<string>();
    deck = shuffle(pairs).filter((p) => {
      if (seen.has(p.a.keyword) || seen.has(p.b.keyword)) return false;
      seen.add(p.a.keyword).add(p.b.keyword);
      return true;
    }).slice(0, ROUNDS);
    round = score = streak = 0;
    marks = [];
    startEl.hidden = true;
    endEl.hidden = true;
    board.classList.remove('is-idle');
    show();
  }

  function show() {
    answered = false;
    const p = deck[round];
    shown = Math.random() < 0.5 ? [p.a, p.b] : [p.b, p.a];
    picks.forEach((b, i) => {
      b.querySelector('.kw-word')!.textContent = shown[i].keyword;
      b.disabled = false;
      b.classList.remove('is-win', 'is-wrong');
    });
    reveal.hidden = true;
    hud();
    picks[0].focus({ preventScroll: true });
  }

  // how many block characters fit on one row, so the bar never overflows a phone screen
  function barWidth(): number {
    const probe = document.createElement('span');
    probe.className = 'kw-bar';
    probe.style.position = 'absolute';
    probe.textContent = '█'.repeat(20);
    rows.append(probe);
    const per = probe.getBoundingClientRect().width / 20;
    probe.remove();
    return Math.max(8, Math.min(80, Math.floor(rows.clientWidth / (per || 9))));
  }

  function guess(i: number) {
    if (answered || !deck.length || !startEl.hidden || !endEl.hidden) return;
    answered = true;
    const winner = shown[0].volume >= shown[1].volume ? 0 : 1;
    const right = i === winner;
    score += right ? 1 : 0;
    streak = right ? streak + 1 : 0;
    marks.push(right);
    picks.forEach((b) => (b.disabled = true));
    picks[winner].classList.add('is-win');
    if (!right) picks[i].classList.add('is-wrong');

    const v = $('kw-verdict');
    v.textContent = right ? 'correct.' : 'nope.';
    v.className = 'kw-verdict ' + (right ? 'game-ok' : 'game-bad');

    reveal.hidden = false;
    const width = barWidth();
    const max = Math.max(shown[0].volume, shown[1].volume);
    rows.replaceChildren(
      ...shown.map((s, k) => {
        const row = document.createElement('div');
        row.className = 'kw-row' + (k === winner ? ' is-win' : '');
        const name = document.createElement('span');
        name.className = 'kw-name';
        name.textContent = s.keyword;
        const num = document.createElement('span');
        num.className = 'kw-num';
        num.textContent = fmt(s.volume);
        const bar = document.createElement('span');
        bar.className = 'kw-bar';
        bar.dataset.n = String(Math.max(1, Math.round((s.volume / max) * width)));
        row.append(name, num, bar);
        return row;
      }),
    );
    growBars();
    $('kw-hint').textContent = deck[round].hint;
    nextBtn.textContent = round + 1 >= ROUNDS ? 'see score' : 'next';
    hud();
    nextBtn.focus({ preventScroll: true });
  }

  function growBars() {
    const bars = [...rows.querySelectorAll<HTMLElement>('.kw-bar')];
    const fill = (f: number) => bars.forEach((b) => (b.textContent = '█'.repeat(Math.max(1, Math.round(Number(b.dataset.n) * f)))));
    if (reduceMotion()) return fill(1);
    const t0 = performance.now();
    const step = (t: number) => {
      const f = Math.min(1, (t - t0) / 450);
      fill(f);
      if (f < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  function band(s: number): string {
    if (s === 10) return 'ten for ten. you are a clickstream panel.';
    if (s >= 8) return 'sharp. you have stared at too many keyword exports.';
    if (s >= 6) return 'decent. better than most volume estimates.';
    if (s >= 4) return 'coin flip territory. so is half the keyword data out there.';
    return 'your gut needs a keyword tool.';
  }

  function next() {
    if (!answered) return;
    round++;
    if (round < ROUNDS) return show();
    if (best == null || score > best) {
      best = score;
      store.set(BEST_KEY, best);
    }
    $('kw-final').textContent = `${score}/${ROUNDS}`;
    $('kw-band').textContent = band(score);
    $('kw-marks').textContent = marks.map((m) => (m ? '■' : '□')).join('');
    shareBtn.textContent = 'share';
    endEl.hidden = false;
    board.classList.add('is-idle');
    hud();
    $('kw-again').focus({ preventScroll: true });
  }

  async function share() {
    const text = `seo intuition test: ${score}/${ROUNDS}\n${marks.map((m) => (m ? '■' : '□')).join('')}\nrobertjohnlora.com/play/keywords/`;
    try {
      if (navigator.share && matchMedia('(pointer: coarse)').matches) await navigator.share({ text });
      else {
        await navigator.clipboard.writeText(text);
        shareBtn.textContent = 'copied';
      }
    } catch {
      shareBtn.textContent = 'copy failed';
    }
  }

  picks.forEach((b, i) => b.addEventListener('click', () => guess(i)));
  nextBtn.addEventListener('click', next);
  $('kw-go').addEventListener('click', start);
  $('kw-again').addEventListener('click', start);
  shareBtn.addEventListener('click', share);

  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey || e.isComposing) return;
    const t = e.target as HTMLElement | null;
    if (t?.closest?.('input, textarea, select, [contenteditable]')) return;
    // a focused button already turns enter and space into a click; handling them here too would fire twice
    const onButton = t?.tagName === 'BUTTON';
    let used = true;
    if (e.key === '1' || e.key === 'ArrowLeft') guess(0);
    else if (e.key === '2' || e.key === 'ArrowRight') guess(1);
    else if ((e.key === 'Enter' || e.key === ' ') && !onButton) {
      if (!startEl.hidden || !endEl.hidden) start();
      else next();
    } else used = false;
    if (used) {
      e.preventDefault();
      e.stopPropagation();
    }
  });

  hud();
</script>

<style>
  /* the overlays sit on an empty board instead of a half-hidden round */
  .kw.is-idle { visibility: hidden; }
  .kw { display: grid; gap: 1.25rem; min-inline-size: 0; min-block-size: 15rem; align-content: start; }
  .kw > * { min-inline-size: 0; }
  .kw-picks { display: grid; grid-template-columns: 1fr auto 1fr; align-items: stretch; gap: 0.75rem; }
  .kw-pick {
    font: inherit; color: var(--fg); background: var(--base); cursor: pointer;
    border: 1px solid var(--hl); border-radius: 5px; padding: 1.25rem 0.75rem;
    display: grid; justify-items: center; gap: 0.6rem; text-align: center; min-block-size: 7rem; align-content: center;
  }
  .kw-pick:hover:not(:disabled) { background: var(--hover); border-color: var(--ctl); }
  .kw-pick:focus-visible { outline: 2px solid var(--t-iris); outline-offset: 2px; }
  .kw-pick:disabled { cursor: default; }
  .kw-pick kbd { color: var(--subtle); }
  .kw-word { font-size: clamp(1rem, 0.9rem + 0.6vw, 1.3rem); font-weight: 650; overflow-wrap: anywhere; }
  .kw-pick.is-win { border-color: var(--t-foam); }
  .kw-pick.is-win .kw-word { color: var(--t-foam); }
  .kw-pick.is-wrong { border-color: var(--t-love); }
  .kw-pick.is-wrong .kw-word { color: var(--t-love); }
  .kw-vs { align-self: center; color: var(--subtle); font-size: var(--fs-small); }
  .kw-reveal { display: grid; gap: 0.75rem; justify-items: start; }
  .kw-reveal[hidden] { display: none; }
  .kw-verdict { margin: 0; font-weight: 650; }
  .kw-rows { display: grid; gap: 0.6rem; inline-size: 100%; min-inline-size: 0; }
  .kw-hint { margin: 0; color: var(--subtle); font-size: var(--fs-small); }
  .kw-marks { margin: 0; font: inherit; letter-spacing: 0.15em; color: var(--t-gold); }
  .kw-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: center; }
  #kw-band { margin: 0; color: var(--fg); }
  @media (max-width: 480px) {
    .kw-picks { grid-template-columns: 1fr; }
    .kw-vs { justify-self: center; }
    .kw-pick { min-block-size: 4.5rem; padding: 0.9rem 0.75rem; }
  }
</style>

<style is:global>
  /* rows are built in script, so they miss astro's scoped attribute; #kw-rows keeps these local */
  #kw-rows .kw-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.15rem 2ch; color: var(--subtle); }
  #kw-rows .kw-row.is-win { color: var(--fg); }
  #kw-rows .kw-name { overflow-wrap: anywhere; }
  #kw-rows .kw-num { font-variant-numeric: tabular-nums; }
  #kw-rows .kw-bar { grid-column: 1 / -1; color: var(--hl); white-space: pre; overflow: hidden; line-height: 1; letter-spacing: 0; }
  #kw-rows .kw-row.is-win .kw-bar { color: var(--t-gold); }
</style>
