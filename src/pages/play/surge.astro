    function addShockwave(x, y, startRadius, maxRadius, color) {
      for (var i = 0; i < 6; i++) {
        if (!shockwaves[i].active) {
          var sw = shockwaves[i];
          sw.active = true; sw.x = x; sw.y = y; sw.radius = startRadius;
          sw.maxRadius = maxRadius; sw.alpha = 0.8; sw.lineWidth = 4; sw.color = color;
          return;
        }
      }
    }

    function updateShockwaves(dt) {
      for (var i = 0; i < 6; i++) {
        var sw = shockwaves[i];
        if (!sw.active) continue;
        sw.radius += 300 * dt;
        sw.alpha = Math.max(0, 0.8 * (1 - sw.radius / sw.maxRadius));
        sw.lineWidth = Math.max(1, 4 * (1 - sw.radius / sw.maxRadius));
        if (sw.radius >= sw.maxRadius) sw.active = false;

        // Push nearby non-homing projectiles outward
        if (sw.alpha > 0.1) {
          for (var j = 0; j < MAX_PROJECTILES; j++) {
            var p = projectiles[j];
            if (!p.active || p.type === 'homing') continue;
            var dx = p.x - sw.x, dy = p.y - sw.y;
            var dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < sw.radius + 20 && dist > sw.radius - 10 && dist > 1) {
              var pushForce = 300 * sw.alpha * dt;
              p.vx += (dx / dist) * pushForce;
              p.vy += (dy / dist) * pushForce;
            }
          }
        }
      }
    }

    // ── PLAYER AFTERIMAGE ───────────────────────────────────────
    var afterimages = [];
    for (var ai = 0; ai < 8; ai++) {
      afterimages.push({ active: false, x: 0, y: 0, alpha: 0 });
    }
    var prevPlayerX = CW / 2, prevPlayerY = CH / 2;

    // ── SHARED STATE ────────────────────────────────────────────
    var minProjectileDist = CW;
    var totalGrazesThisGame = 0;
    var deathCracks = [];
    var deathRainActive = false;

    // ── POWER-UP STATE ──────────────────────────────────────────
    var magnetActive = false, magnetTimer = 0;
    var timeWarpActive = false, timeWarpTimer = 0;

    // ── COMBO VISUALS ───────────────────────────────────────────
    var comboBorderAlpha = 0;
    var desatTimer = 0;
    // ── PLAYER ──────────────────────────────────────────────────
    var player = {
      x: CW / 2, y: CH / 2,
      targetX: CW / 2, targetY: CH / 2,
      radius: PLAYER_RADIUS,
      trail: [],
      alive: true,
      shieldTokens: 0,
      shieldCharged: false,
      shieldActive: false,
      shieldTimer: 0,
      shieldKillsThisActivation: 0
    };

    // ── BACKGROUND DOTS ─────────────────────────────────────────
    var bgDots = [];
    for (var di = 0; di < 50; di++) {
      bgDots.push({
        x: Math.random() * CW, y: Math.random() * CH,
        size: 1 + Math.random() * 1.5, depth: 0.3 + Math.random() * 0.7
      });
    }

    // ── START SCREEN NODES ──────────────────────────────────────
    var startNodes = [];
    for (var ni = 0; ni < 18; ni++) {
      startNodes.push({
        x: Math.random() * CW, y: Math.random() * CH,
        vx: (Math.random() - 0.5) * 15,
        vy: (Math.random() - 0.5) * 15,
        r: 2 + Math.random() * 2
      });
    }

    // ── SCREEN EFFECTS ──────────────────────────────────────────
    var shakeTrauma = 0;
    function addShake(amount) { shakeTrauma = Math.min(1, shakeTrauma + amount); }
    function getShakeOffset() {
      if (shakeTrauma < 0.01) { shakeTrauma = 0; return { x: 0, y: 0 }; }
      var intensity = shakeTrauma * shakeTrauma;
      shakeTrauma *= 0.9;
      return { x: (Math.random() * 2 - 1) * 12 * intensity, y: (Math.random() * 2 - 1) * 12 * intensity };
    }

    var freezeFrames = 0;
    function triggerFreeze(frames) { freezeFrames = Math.max(freezeFrames, frames); }

    var flashAlpha = 0;
    var flashColor = '#ffffff';
    function triggerFlash(alpha, color) { flashAlpha = alpha; flashColor = color || '#ffffff'; }

    var slowMo = 1.0;
    var slowMoTarget = 1.0;

    // ── GAME STATE ──────────────────────────────────────────────
    var gameState = 'MENU'; // MENU, PLAYING, PAUSED, DYING, GAME_OVER
    var score = 0;
    var comboCount = 0;
    var comboTimer = 0;
    var gameTime = 0;
    var survivalTime = 0;
    var frameCount = 0;
    var deathFrameCount = 0;
    var waveGrazesThisWave = 0;
    var keysHeld = { up: false, down: false, left: false, right: false };
    var KEYBOARD_SPEED = 380;
    var tokenSpawnTimer = 0;
    var bestComboThisGame = 0;

    // ── BEAM WARNINGS ───────────────────────────────────────────
    var beamWarnings = [];

    // ── WAVE STATE ──────────────────────────────────────────────
    var wave = {
      number: 0,
      state: 'IDLE',
      timer: 0,
      patternTimer: 0,
      patternType: '',
      spawned: 0,
      toSpawn: 0,
      difficulty: 1.0,
      name: '',
      announceAlpha: 0,
      announceScale: 1,
      spiralAngle: 0,
      beamWarningDone: false,
      subPatterns: []
    };

    // ── WAVE PATTERNS ───────────────────────────────────────────
    function pickPattern(n) {
      var pool = ['linear', 'radial'];
      if (n >= 5) pool.push('spiral');
      if (n >= 8) pool.push('homing');
      if (n >= 10) pool.push('grid');
      if (n >= 12) pool.push('beam');
      if (n >= 15 && Math.random() < 0.3) return 'combo';
      return pool[Math.floor(Math.random() * pool.length)];
    }

    function initPattern(type) {
      var d = wave.difficulty;
      wave.spawned = 0;
      wave.patternTimer = 0;
      wave.spiralAngle = 0;
      wave.beamWarningDone = false;

      switch (type) {
        case 'linear':
          wave.toSpawn = Math.floor(8 + d * 3);
          wave._edge = Math.floor(Math.random() * 4);
          break;
        case 'radial':
          wave.toSpawn = Math.floor(12 + d * 4);
          // Ensure origin is at least 80px from player
          do {
            wave._originX = CW * 0.2 + Math.random() * CW * 0.6;
            wave._originY = CH * 0.2 + Math.random() * CH * 0.6;
          } while (Math.sqrt(Math.pow(wave._originX - player.x, 2) + Math.pow(wave._originY - player.y, 2)) < 80);
          break;
        case 'spiral':
          wave.toSpawn = Math.floor(20 + d * 5);
          break;
        case 'homing':
          wave.toSpawn = Math.floor(3 + d * 1.5);
          break;
        case 'grid':
          var gridSize = Math.floor(3 + d * 0.5);
          wave.toSpawn = gridSize * gridSize;
          wave._gridSize = gridSize;
          break;
        case 'beam':
          wave.toSpawn = Math.floor(15 + d * 3);
          var angle = Math.random() * Math.PI;
          var cx = CW / 2, cy = CH / 2;
          var len = CW * 0.8;
          wave._beamX1 = cx + Math.cos(angle) * len;
          wave._beamY1 = cy + Math.sin(angle) * len;
          wave._beamX2 = cx - Math.cos(angle) * len;
          wave._beamY2 = cy - Math.sin(angle) * len;
          wave._beamAngle = angle;
          beamWarnings.push({
            x1: wave._beamX1, y1: wave._beamY1,
            x2: wave._beamX2, y2: wave._beamY2,
            timer: 1.0
          });
          break;
        case 'combo':
          var types = ['linear', 'radial', 'spiral', 'homing', 'grid'];
          var t1 = types[Math.floor(Math.random() * types.length)];
          var t2 = types[Math.floor(Math.random() * types.length)];
          while (t2 === t1) t2 = types[Math.floor(Math.random() * types.length)];
          wave.subPatterns = [t1, t2];
          wave._comboPhase = 0;
          wave.toSpawn = 999;
          initPattern(t1);
          wave.patternType = 'combo';
          wave._savedToSpawn = wave.toSpawn;
          break;
      }
    }

    function updatePattern(type, dt) {
      var d = wave.difficulty;
      var baseSpeed = 100 + d * 25;

      switch (type) {
        case 'linear': {
          var interval = 0.08 / Math.min(d, 2);
          wave.patternTimer += dt;
          while (wave.patternTimer >= interval && wave.spawned < wave.toSpawn) {
            wave.patternTimer -= interval;
            var p = getProjectile();
            if (!p) break;
            var edge = wave._edge;
            var t = wave.spawned / wave.toSpawn;
            p.active = true; p.grazed = false; p.type = 'normal';
            p.radius = PROJ_RADIUS; p.color = COLORS.projRed;
            p.life = 6;
            if (edge === 0) { p.x = t * CW; p.y = -10; p.vx = 0; p.vy = baseSpeed; }
            else if (edge === 1) { p.x = CW + 10; p.y = t * CH; p.vx = -baseSpeed; p.vy = 0; }
            else if (edge === 2) { p.x = t * CW; p.y = CH + 10; p.vx = 0; p.vy = -baseSpeed; }
            else { p.x = -10; p.y = t * CH; p.vx = baseSpeed; p.vy = 0; }
            wave.spawned++;
          }
          break;
        }
        case 'radial': {
          if (wave.spawned === 0) {
            for (var i = 0; i < wave.toSpawn; i++) {
              var p = getProjectile();
              if (!p) break;
              var angle = (Math.PI * 2 / wave.toSpawn) * i;
              p.active = true; p.grazed = false; p.type = 'normal';
              p.radius = PROJ_RADIUS; p.color = COLORS.projRed;
              p.life = 5;
              p.x = wave._originX; p.y = wave._originY;
              p.vx = Math.cos(angle) * baseSpeed * 0.8;
              p.vy = Math.sin(angle) * baseSpeed * 0.8;
              wave.spawned++;
            }
          }
          break;
        }
        case 'spiral': {
          var interval = 0.06 / Math.min(d, 2.5);
          wave.patternTimer += dt;
          while (wave.patternTimer >= interval && wave.spawned < wave.toSpawn) {
            wave.patternTimer -= interval;
            var p = getProjectile();
            if (!p) break;
            wave.spiralAngle += 0.35;
            p.active = true; p.grazed = false; p.type = 'normal';
            p.radius = PROJ_RADIUS; p.color = COLORS.projRed;
            p.life = 5;
            p.x = CW / 2; p.y = CH / 2;
            p.vx = Math.cos(wave.spiralAngle) * baseSpeed * 0.9;
            p.vy = Math.sin(wave.spiralAngle) * baseSpeed * 0.9;
            wave.spawned++;
          }
          break;
        }
        case 'homing': {
          if (wave.spawned === 0) {
            var edge = Math.floor(Math.random() * 4);
            for (var i = 0; i < wave.toSpawn; i++) {
              var p = getProjectile();
              if (!p) break;
              p.active = true; p.grazed = false; p.type = 'homing';
              p.radius = PROJ_RADIUS + 1; p.color = COLORS.projHeavy;
              p.life = 5;
              if (edge === 0) { p.x = Math.random() * CW; p.y = -10; }
              else if (edge === 1) { p.x = CW + 10; p.y = Math.random() * CH; }
              else if (edge === 2) { p.x = Math.random() * CW; p.y = CH + 10; }
              else { p.x = -10; p.y = Math.random() * CH; }
              var dx = player.x - p.x, dy = player.y - p.y;
              p.homingAngle = Math.atan2(dy, dx);
              var spd = 70 + d * 10;
              p.vx = Math.cos(p.homingAngle) * spd;
              p.vy = Math.sin(p.homingAngle) * spd;
              wave.spawned++;
            }
          }
          break;
        }
        case 'grid': {
          if (wave.spawned === 0) {
            var gs = wave._gridSize;
            var spacing = CW / (gs + 1);
            for (var gx = 0; gx < gs; gx++) {
              for (var gy = 0; gy < gs; gy++) {
                var p = getProjectile();
                if (!p) break;
                p.active = true; p.grazed = false; p.type = 'normal';
                p.radius = PROJ_RADIUS; p.color = COLORS.projRed;
                p.life = 5;
                p.x = CW / 2; p.y = CH / 2;
                var tx = spacing * (gx + 1) - CW / 2;
                var ty = spacing * (gy + 1) - CH / 2;
                var dist = Math.sqrt(tx * tx + ty * ty) || 1;
                p.vx = (tx / dist) * baseSpeed * 0.7;
                p.vy = (ty / dist) * baseSpeed * 0.7;
                wave.spawned++;
              }
            }
          }
          break;
        }
        case 'beam': {
          if (!wave.beamWarningDone) {
            if (beamWarnings.length === 0) wave.beamWarningDone = true;
            break;
          }
          var interval = 0.03 / Math.min(d, 2);
          wave.patternTimer += dt;
          while (wave.patternTimer >= interval && wave.spawned < wave.toSpawn) {
            wave.patternTimer -= interval;
            var p = getProjectile();
            if (!p) break;
            var t = wave.spawned / wave.toSpawn;
            p.active = true; p.grazed = false; p.type = 'normal';
            p.radius = PROJ_RADIUS - 1; p.color = COLORS.projRed;
            p.life = 4;
            p.x = wave._beamX1 + (wave._beamX2 - wave._beamX1) * t;
            p.y = wave._beamY1 + (wave._beamY2 - wave._beamY1) * t;
            var perpAngle = wave._beamAngle + Math.PI / 2;
            var beamSpeed = baseSpeed * 1.5;
            p.vx = Math.cos(perpAngle) * beamSpeed;
            p.vy = Math.sin(perpAngle) * beamSpeed;
            wave.spawned++;
          }
          break;
        }
        case 'combo': {
          var sub = wave.subPatterns[wave._comboPhase];
          if (wave._comboPhase === 0) {
            updatePattern(sub, dt);
            if (wave.spawned >= wave._savedToSpawn) {
              wave._comboPhase = 1;
              wave.spawned = 0;
              wave.patternTimer = 0;
              wave.spiralAngle = 0;
              var saved = wave.patternType;
              initPattern(wave.subPatterns[1]);
              wave.patternType = saved;
              wave._savedToSpawn = wave.toSpawn;
            }
          } else {
            updatePattern(wave.subPatterns[1], dt);
          }
          break;
        }
      }
    }

    function isPatternComplete(type) {
      if (type === 'beam' && !wave.beamWarningDone) return false;
      if (type === 'combo') {
        return wave._comboPhase === 1 && wave.spawned >= wave._savedToSpawn;
      }
      return wave.spawned >= wave.toSpawn;
    }

    function getBreathingTime() {
      return Math.max(1.5, 3.0 - wave.number * 0.08);
    }

    // ── WAVE UPDATE ─────────────────────────────────────────────
    function updateWaves(dt) {
      // Update beam warnings
      for (var i = beamWarnings.length - 1; i >= 0; i--) {
        beamWarnings[i].timer -= dt;
        if (beamWarnings[i].timer <= 0) {
          beamWarnings.splice(i, 1);
        }
      }

      switch (wave.state) {
        case 'IDLE':
          wave.timer -= dt;
          if (wave.timer <= 0) {
            wave.number++;
            wave.difficulty = 1.0 + (wave.number - 1) * 0.15;
            wave.name = WAVE_NAMES[(wave.number - 1) % WAVE_NAMES.length];
            wave.state = 'ANNOUNCE';
            wave.timer = 1.5;
            wave.announceAlpha = 1;
            wave.announceScale = 1.5;
            waveGrazesThisWave = 0;
            playWaveAnnounce();
            musicEngine.setWave(wave.number);
          }
          break;
        case 'ANNOUNCE':
          wave.timer -= dt;
          wave.announceAlpha = Math.max(0, wave.timer / 1.5);
          wave.announceScale = 1.0 + 0.5 * Math.max(0, wave.timer / 1.5);
          if (wave.timer <= 0) {
            wave.state = 'ACTIVE';
            wave.patternType = pickPattern(wave.number);
            initPattern(wave.patternType);
          }
          break;
        case 'ACTIVE':
          updatePattern(wave.patternType, dt);
          if (isPatternComplete(wave.patternType)) {
            wave.state = 'CLEARING';
            wave.timer = getBreathingTime();
            if (waveGrazesThisWave >= 5) awardAchievement('closeCall');
            if (wave.number >= 10) awardAchievement('wave10');
            if (wave.number >= 20) awardAchievement('wave20');
            if (wave.number >= 30) awardAchievement('wave30');
          }
          break;
        case 'CLEARING':
          wave.timer -= dt;
          if (wave.timer <= 0) {
            wave.state = 'IDLE';
            wave.timer = 0.3;
          }
          break;
      }
    }

    // ── TOKEN SPAWNING ──────────────────────────────────────────
    function updateTokenSpawning(dt) {
      tokenSpawnTimer -= dt;
      if (tokenSpawnTimer <= 0 && countActiveTokens() < 3) {
        tokenSpawnTimer = 1.8 + Math.random() * 1.5;
        var tk = getActiveToken();
        if (tk) {
          tk.active = true;
          tk.rotation = 0;
          var margin = 50;
          tk.x = margin + Math.random() * (CW - margin * 2);
          tk.y = margin + Math.random() * (CH - margin * 2);
          // 8% chance of power-up
          var roll = Math.random();
          if (roll < 0.027) tk.powerType = 'magnet';
          else if (roll < 0.054) tk.powerType = 'timewarp';
          else if (roll < 0.08) tk.powerType = 'scoreburst';
          else tk.powerType = 'normal';
        }
      }
    }

    // ── UPDATE PROJECTILES ──────────────────────────────────────
    function updateProjectiles(gameDt) {
      minProjectileDist = CW;
      for (var i = 0; i < MAX_PROJECTILES; i++) {
        var p = projectiles[i];
        if (!p.active) continue;

        // Store trail position before moving
        for (var ti = 5; ti > 0; ti--) { p.trailX[ti] = p.trailX[ti-1]; p.trailY[ti] = p.trailY[ti-1]; }
        p.trailX[0] = p.x; p.trailY[0] = p.y;
        if (p.trailLen < 6) p.trailLen++;

        if (p.type === 'homing' && player.alive) {
          var dx = player.x - p.x, dy = player.y - p.y;
          var target = Math.atan2(dy, dx);
          var diff = target - p.homingAngle;
          while (diff > Math.PI) diff -= Math.PI * 2;
          while (diff < -Math.PI) diff += Math.PI * 2;
          var maxTurn = 1.8 * gameDt;
          if (diff > maxTurn) diff = maxTurn;
          if (diff < -maxTurn) diff = -maxTurn;
          p.homingAngle += diff;
          var spd = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
          p.vx = Math.cos(p.homingAngle) * spd;
          p.vy = Math.sin(p.homingAngle) * spd;
        }

        p.x += p.vx * gameDt;
        p.y += p.vy * gameDt;
        p.life -= gameDt;

        if (p.life <= 0) { p.active = false; p.trailLen = 0; continue; }
        var margin = 60;
        if (p.x < -margin || p.x > CW + margin || p.y < -margin || p.y > CH + margin) {
          p.active = false; p.trailLen = 0; continue;
        }

        // Track closest projectile distance for heartbeat/vignette
        if (player.alive) {
          var pdx = player.x - p.x, pdy = player.y - p.y;
          var pdist = Math.sqrt(pdx * pdx + pdy * pdy);
          if (pdist < minProjectileDist) minProjectileDist = pdist;
        }
      }
    }

    // ── UPDATE PARTICLES ────────────────────────────────────────
    function updateParticles(dt) {
      for (var i = 0; i < MAX_PARTICLES; i++) {
        var p = particles[i];
        if (!p.active) continue;
        p.x += p.vx * dt;
        p.y += p.vy * dt;
        p.vx *= 0.96;
        p.vy *= 0.96;
        p.life -= dt;
        if (p.life <= 0) p.active = false;
      }
    }

    // ── UPDATE FLOATING TEXTS ───────────────────────────────────
    function updateFloatingTexts(dt) {
      for (var i = 0; i < MAX_FLOAT_TEXTS; i++) {
        var f = floatingTexts[i];
        if (!f.active) continue;
        f.y += f.vy * dt;
        f.vy *= 0.95;
        f.life -= dt;
        var progress = 1 - (f.life / f.maxLife);
        if (progress < 0.2) {
          var t = progress / 0.2;
          f.scale = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
          f.scale = f.scale * 1.2;
          if (f.scale > 1) f.scale = 1 + (f.scale - 1) * 0.5;
        } else {
          f.scale = 1;
        }
        if (f.life <= 0) f.active = false;
      }
    }

    // ── UPDATE TOKENS ───────────────────────────────────────────
    function updateTokens(dt) {
      for (var i = 0; i < MAX_TOKENS; i++) {
        var tk = tokenPool[i];
        if (!tk.active) continue;
        tk.rotation += dt * 1.5;

        // Token magnetism: drift toward player within 50px
        var tdx = player.x - tk.x, tdy = player.y - tk.y;
        var tdist = Math.sqrt(tdx * tdx + tdy * tdy);
        var magRange = magnetActive ? 200 : 50;
        var magSpeed = magnetActive ? 8 : 4;
        if (tdist < magRange && tdist > player.radius + tk.radius) {
          tk.x += (player.x - tk.x) * magSpeed * dt;
          tk.y += (player.y - tk.y) * magSpeed * dt;
        }
      }
    }

    // ── UPDATE POWER-UPS ────────────────────────────────────────
    function updatePowerUps(dt) {
      if (magnetActive) { magnetTimer -= dt; if (magnetTimer <= 0) { magnetActive = false; magnetTimer = 0; } }
      if (timeWarpActive) { timeWarpTimer -= dt; if (timeWarpTimer <= 0) { timeWarpActive = false; timeWarpTimer = 0; } }
    }

    // ── COLLISION DETECTION ─────────────────────────────────────
    function checkCollisions() {
      if (!player.alive) return;

      for (var i = 0; i < MAX_PROJECTILES; i++) {
        var p = projectiles[i];
        if (!p.active) continue;

        var dx = player.x - p.x, dy = player.y - p.y;
        var dist = Math.sqrt(dx * dx + dy * dy);
        var hitDist = player.radius + p.radius;
        var grazeDist = hitDist + GRAZE_MARGIN;

        // Shield destruction
        if (player.shieldActive) {
          if (dist < SHIELD_RADIUS + p.radius) {
            p.active = false;
            spawnParticles(p.x, p.y, COLORS.shield, 4, 80);
            player.shieldKillsThisActivation++;
            score += 2;
            addFloatingText('+2', p.x, p.y - 5, COLORS.shield, 12);
            playShieldKill();
            stats.totalShieldKills++;
            continue;
          }
        }

        // Hit detection
        if (dist < hitDist && !player.shieldActive) {
          onPlayerDeath();
          return;
        }

        // Graze detection
        if (!p.grazed && dist < grazeDist && dist >= hitDist) {
          p.grazed = true;
          score += 2;
          stats.totalGrazes++;
          waveGrazesThisWave++;
          totalGrazesThisGame++;
          // Grazes feed the combo chain
          if (comboTimer > 0) comboCount++;
          else comboCount = 1;
          comboTimer = COMBO_WINDOW;
          if (comboCount > bestComboThisGame) bestComboThisGame = comboCount;
          if (comboCount > stats.longestCombo) stats.longestCombo = comboCount;
          triggerFreeze(1);

          // Directional particle burst perpendicular to graze line
          var grazeAngle = Math.atan2(dy, dx);
          var perpAngle = grazeAngle + Math.PI / 2;
          for (var gi = 0; gi < 5; gi++) {
            var spread = perpAngle + (Math.random() - 0.5) * 1.2;
            var gspd = 40 + Math.random() * 60;
            spawnParticle(
              p.x + (dx / dist) * p.radius, p.y + (dy / dist) * p.radius,
              COLORS.playerGlow, Math.cos(spread) * gspd, Math.sin(spread) * gspd,
              1 + Math.random() * 1.5, 0.2
            );
          }

          // Graze flash line from projectile to player edge
          var edgeX = player.x - (dx / dist) * player.radius;
          var edgeY = player.y - (dy / dist) * player.radius;
          addGrazeFlash(p.x, p.y, edgeX, edgeY);
          playGraze();
        }
      }

      // Token collection
      for (var j = 0; j < MAX_TOKENS; j++) {
        var tk = tokenPool[j];
        if (!tk.active) continue;
        var dx2 = player.x - tk.x, dy2 = player.y - tk.y;
        var dist2 = Math.sqrt(dx2 * dx2 + dy2 * dy2);
        if (dist2 < player.radius + tk.radius) {
          collectToken(tk);
        }
      }
    }

    // ── TOKEN COLLECTION ────────────────────────────────────────
    function collectToken(tk) {
      var pType = tk.powerType;
      tk.active = false;

      // Handle power-ups
      if (pType === 'magnet') {
        magnetActive = true; magnetTimer = 3.0;
        addFloatingText('MAGNET!', tk.x, tk.y - 15, '#22D3EE', 18);
        spawnParticles(tk.x, tk.y, '#22D3EE', 12, 120);
        addShockwave(tk.x, tk.y, 10, 100, '#22D3EE');
        addShake(0.3); triggerFreeze(4); playComboMilestone();
        return;
      }
      if (pType === 'timewarp') {
        timeWarpActive = true; timeWarpTimer = 3.0;
        addFloatingText('TIME WARP!', tk.x, tk.y - 15, '#A78BFA', 18);
        spawnParticles(tk.x, tk.y, '#A78BFA', 12, 120);
        addShockwave(tk.x, tk.y, 10, 100, '#A78BFA');
        addShake(0.3); triggerFreeze(4); playComboMilestone();
        return;
      }
      if (pType === 'scoreburst') {
        score += 10;
        comboTimer = COMBO_WINDOW; // Keep combo alive
        addFloatingText('+10!', tk.x, tk.y - 15, COLORS.text, 22);
        spawnParticles(tk.x, tk.y, COLORS.text, 20, 150);
        addShockwave(tk.x, tk.y, 10, 120, COLORS.text);
        addShake(0.4); triggerFreeze(5); triggerFlash(0.15, COLORS.text); playHighScore();
        return;
      }

      if (comboTimer > 0) comboCount++;
      else comboCount = 1;
      comboTimer = COMBO_WINDOW;

      var multiplier = 1;
      if (comboCount >= 10) multiplier = 4;
      else if (comboCount >= 6) multiplier = 3;
      else if (comboCount >= 3) multiplier = 2;

      score += multiplier;
      stats.totalTokens++;
      desatTimer = 0.08;

      if (comboCount > bestComboThisGame) bestComboThisGame = comboCount;
      if (comboCount > stats.longestCombo) stats.longestCombo = comboCount;

      player.shieldTokens++;
      if (player.shieldTokens >= SHIELD_CHARGE_NEEDED && !player.shieldCharged && !player.shieldActive) {
        player.shieldCharged = true;
        shieldFill.classList.add('ss-charged');
        playShieldCharged();
      }

      addFloatingText('+' + multiplier, tk.x, tk.y - 10, COLORS.tokenGold, 16);
      if (comboCount > 1) {
        addFloatingText('x' + comboCount, tk.x + 20, tk.y, COLORS.player, 12);
      }
      spawnParticles(tk.x, tk.y, COLORS.tokenGold, 6, 100);
      playTokenCollect();
      triggerFreeze(2);
      addShake(0.15);

      // Combo milestone with escalating feedback
      if (comboCount === 3 || comboCount === 6 || comboCount === 10 || comboCount === 15) {
        var cShake = comboCount >= 15 ? 0.7 : comboCount >= 10 ? 0.5 : comboCount >= 6 ? 0.3 : 0.2;
        var cParts = comboCount >= 15 ? 50 : comboCount >= 10 ? 30 : comboCount >= 6 ? 20 : 10;
        var cSize = comboCount >= 15 ? 32 : comboCount >= 10 ? 28 : comboCount >= 6 ? 24 : 20;
        playComboMilestone();
        addFloatingText('COMBO x' + comboCount + '!', CW / 2, CH / 2, COLORS.player, cSize);
        spawnParticles(CW / 2, CH / 2, COLORS.player, cParts, 150);
        addShake(cShake);
        triggerFreeze(comboCount >= 10 ? 6 : 4);
        if (comboCount >= 10) addShockwave(CW / 2, CH / 2, 15, 140, COLORS.player);
      }

      // Update combo border glow target
      if (comboCount >= 15) comboBorderAlpha = 0.25;
      else if (comboCount >= 10) comboBorderAlpha = 0.18;
      else if (comboCount >= 6) comboBorderAlpha = 0.1;
      else if (comboCount >= 3) comboBorderAlpha = 0.05;
      else comboBorderAlpha = 0;

      if (stats.totalTokens === 1) awardAchievement('firstToken');
      if (comboCount >= 5) awardAchievement('combo5');
      if (comboCount >= 10) awardAchievement('combo10');
      if (comboCount >= 15) awardAchievement('combo15');
    }

    // ── SHIELD ──────────────────────────────────────────────────
    function activateShield() {
      if (!player.shieldCharged || player.shieldActive) return;
      if (gameState !== 'PLAYING') return;
      player.shieldCharged = false;
      player.shieldActive = true;
      player.shieldTimer = SHIELD_DURATION;
      player.shieldTokens = 0;
      player.shieldKillsThisActivation = 0;
      shieldFill.classList.remove('ss-charged');
      slowMoTarget = 0.4;
      playShieldActivate();
      addShake(0.3);
      triggerFlash(0.2, COLORS.shield);
      spawnParticles(player.x, player.y, COLORS.shield, 12, 120);
      addShockwave(player.x, player.y, SHIELD_RADIUS, 180, COLORS.shield);
    }

    function updateShield(realDt) {
      if (!player.shieldActive) return;
      player.shieldTimer -= realDt;
      if (player.shieldTimer <= 0) {
        player.shieldActive = false;
        slowMoTarget = 1.0;
        if (player.shieldKillsThisActivation >= 10) awardAchievement('shieldMaster');
      }
    }

    // ── DEATH ───────────────────────────────────────────────────
    function onPlayerDeath() {
      player.alive = false;
      gameState = 'DYING';
      deathFrameCount = 0;
      slowMoTarget = 0.08;
      addShake(1.0);
      triggerFlash(0.5, COLORS.projRed);
      triggerFreeze(8);
      playDeath();
      spawnParticles(player.x, player.y, getPlayerColor(gameTime), 30, 200);
      deathRainActive = true;

      // Screen crack lines radiating from death position
      deathCracks = [];
      for (var ci = 0; ci < 7; ci++) {
        var cAngle = (Math.PI * 2 / 7) * ci + (Math.random() - 0.5) * 0.4;
        var cLen = 40 + Math.random() * 80;
        deathCracks.push({
          x1: player.x, y1: player.y,
          x2: player.x + Math.cos(cAngle) * cLen, y2: player.y + Math.sin(cAngle) * cLen,
          alpha: 0.8
        });
      }

      // 3 staggered shockwaves
      addShockwave(player.x, player.y, 10, 120, COLORS.projRed);
      setTimeout(function() { addShockwave(player.x, player.y, 8, 100, COLORS.player); }, 160);
      setTimeout(function() { addShockwave(player.x, player.y, 5, 80, COLORS.text); }, 320);
    }

    function endGame() {
      gameState = 'GAME_OVER';
      slowMoTarget = 1.0;
      slowMo = 1.0;

      stats.totalGames++;
      if (survivalTime > stats.longestSurvival) stats.longestSurvival = survivalTime;
      updateStreak();

      var isNewHigh = score > stats.highScore;
      if (isNewHigh) {
        stats.highScore = score;
        bestEl.textContent = stats.highScore;
        triggerFlash(0.3, COLORS.tokenGold);
        playHighScore();
      }

      if (stats.totalGames >= 25) awardAchievement('persistent');
      if (stats.totalGames >= 100) awardAchievement('dedicated');
      if (score >= 500 && survivalTime < 60) awardAchievement('speedDemon');

      var h = new Date().getHours();
      if (h >= 0 && h < 5) awardAchievement('nightOwl');

      saveStats();
      buildSkinSelector();
      showGameOver(score, isNewHigh);
    }

    // ── SCORE RANK ──────────────────────────────────────────────
    function getRank(s) {
      for (var i = 0; i < RANK_TIERS.length; i++) {
        if (s >= RANK_TIERS[i].min) return RANK_TIERS[i];
      }
      return RANK_TIERS[RANK_TIERS.length - 1];
    }

    function getRankQuip(s) {
      if (s < 50) return 'Google forgot you existed.';
      if (s < 150) return 'You got crawled, at least.';
      if (s < 300) return 'Nobody clicks here.';
      if (s < 500) return 'Almost visible.';
      if (s < 800) return 'Above the fold.';
      if (s < 1500) return 'Respectable authority.';
      if (s < 2500) return 'Zero-click gold.';
      return 'You ARE the answer.';
    }

    // ── ACHIEVEMENTS ────────────────────────────────────────────
    var toastQueue = [];
    var toastShowing = false;

    function awardAchievement(key) {
      if (stats.achievements[key]) return;
      stats.achievements[key] = true;
      saveStats();
      toastQueue.push(key);
      triggerFlash(0.15, COLORS.tokenGold);
      addShake(0.2);
      if (!toastShowing) showNextToast();
    }

    function showNextToast() {
      if (toastQueue.length === 0) { toastShowing = false; return; }
      toastShowing = true;
      var key = toastQueue.shift();
      var ach = ACHIEVEMENTS[key];
      if (!ach) { showNextToast(); return; }
      toastEl.querySelector('.ss-toast-icon').textContent = ach.icon;
      toastEl.querySelector('.ss-toast-name').textContent = ach.name;
      toastEl.querySelector('.ss-toast-desc').textContent = ach.desc;
      toastEl.classList.add('ss-show');
      setTimeout(function() {
        toastEl.classList.remove('ss-show');
        setTimeout(showNextToast, 400);
      }, 2500);
    }

    // ── MILESTONES ──────────────────────────────────────────────
    var milestoneTimeout = null;
    function showMilestone(text) {
      milestoneMsg.textContent = text;
      milestoneMsg.classList.add('ss-show');
      clearTimeout(milestoneTimeout);
      milestoneTimeout = setTimeout(function() {
        milestoneMsg.classList.remove('ss-show');
      }, 5000);
    }

    function checkMilestones() {
      if (stats.totalGames === 1 && !stats.milestonesShown.game1) {
        stats.milestonesShown.game1 = true;
        showMilestone('First algorithm dodged.');
      } else if (stats.totalGames === 10 && !stats.milestonesShown.game10) {
        stats.milestonesShown.game10 = true;
        showMilestone('You keep coming back.');
      } else if (stats.totalGames === 50 && !stats.milestonesShown.game50) {
        stats.milestonesShown.game50 = true;
        showMilestone('50 games. Algorithm-hardened.');
      }
    }

    // ── OVERLAY ─────────────────────────────────────────────────
    function hideOverlay() {
      if (overlay.classList.contains('ss-start-screen')) {
        overlay.classList.add('ss-dismissing');
        setTimeout(function() {
          overlay.classList.add('ss-hidden');
          overlay.classList.remove('ss-start-screen', 'ss-dismissing');
        }, 400);
      } else {
        overlay.classList.add('ss-hidden');
        overlay.classList.remove('ss-dismissing');
      }
    }

    function showStartScreen() {
      overlay.classList.remove('ss-hidden', 'ss-dismissing');
      overlay.classList.add('ss-start-screen');

      var html = '<div class="ov-node-art">' +
        '<div class="nd"></div><div class="nd"></div><div class="nd"></div><div class="nd"></div><div class="nd"></div>' +
        '</div>' +
        '<div class="ov-title">SERP <span class="ss-title-accent">Surge</span></div>' +
        '<div class="ov-tagline">dodge &middot; collect &middot; survive</div>' +
        '<div class="ov-prompt">' + (isTouchDevice ? 'Tap to Start' : 'Press Space to Start') + '</div>';

      if (stats.totalGames > 0) {
        var achCount = Object.keys(stats.achievements).length;
        html += '<div class="ov-stats-preview">' +
          '<span>Best: ' + stats.highScore + '</span>' +
          '<span>Waves: ' + Math.floor(stats.longestSurvival / 5) + '</span>' +
          '<span>' + achCount + '/' + Object.keys(ACHIEVEMENTS).length + ' \uD83C\uDFC6</span>' +
          '</div>';
      }

      overlay.innerHTML = html;
    }

    function showGameOver(finalScore, isNewHigh) {
      overlay.classList.remove('ss-hidden', 'ss-start-screen', 'ss-dismissing');

      var rank = getRank(finalScore);
      var html = '<div class="ov-score-label">Game Over</div>';
      html += '<div class="ov-score-big">' + finalScore + '</div>';
      if (isNewHigh) html += '<div class="ov-new-high">\uD83C\uDFC6 New Best!</div>';

      html += '<div class="ov-rank-name" style="color:' + rank.color + '">' + rank.name + '</div>';

      var high = Math.max(stats.highScore, finalScore, 1);
      var yourPct = Math.round((finalScore / high) * 80);
      yourPct = Math.max(20, Math.min(85, yourPct));

      html += '<div class="ov-rank-visual">';
      html += '<div class="ov-rank-bar" style="width:' + Math.min(95, yourPct + 15) + '%;animation-delay:0.4s"><span class="ov-rank-pos">#1</span></div>';
      html += '<div class="ov-rank-bar ov-rank-you" style="width:' + yourPct + '%;animation-delay:0.5s"><span class="ov-rank-pos">You</span></div>';
      html += '<div class="ov-rank-bar" style="width:' + Math.max(15, yourPct - 20) + '%;animation-delay:0.6s"><span class="ov-rank-pos">#3</span></div>';
      html += '</div>';

      html += '<div class="ov-quip">' + getRankQuip(finalScore) + '</div>';
      html += '<div class="ov-game-stat">Wave ' + wave.number + ' \u00B7 ' + Math.floor(survivalTime) + 's survived</div>';
      if (totalGrazesThisGame > 0) {
        html += '<div class="ov-game-stat">' + totalGrazesThisGame + ' close calls</div>';
      }
      if (bestComboThisGame >= 2) {
        html += '<div class="ov-game-stat">Best combo: ' + bestComboThisGame + 'x</div>';
      }
      html += '<div class="ov-sub">' + (isTouchDevice ? 'Tap to Restart' : 'Space to Restart') + '</div>';

      overlay.innerHTML = html;
      checkMilestones();
    }

    // ── KONAMI CODE ─────────────────────────────────────────────
    var konamiSeq = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
    var konamiIndex = 0;

    function checkKonami(key) {
      var expected = konamiSeq[konamiIndex];
      if (key === expected || key.toLowerCase() === expected) {
        konamiIndex++;
        if (konamiIndex >= konamiSeq.length) {
          konamiIndex = 0;
          if (!stats.konami) {
            stats.konami = true;
            saveStats();
            awardAchievement('konami');
            spawnParticles(CW / 2, CH / 2, '#ff00ff', 80, 200);
            addShake(0.6);
            triggerFlash(0.4, '#ff00ff');
            playComboMilestone();
            buildSkinSelector();
          }
        }
      } else {
        konamiIndex = (key === konamiSeq[0] || key.toLowerCase() === konamiSeq[0]) ? 1 : 0;
      }
    }

    // ── GAME FLOW ───────────────────────────────────────────────
    function startGame() {
      gameState = 'PLAYING';
      hideOverlay();
      try { if (!stats.musicMuted && !musicEngine.playing) musicEngine.start(); } catch(e) {}
    }

    function resetGame() {
      score = 0;
      comboCount = 0;
      comboTimer = 0;
      gameTime = 0;
      survivalTime = 0;
      frameCount = 0;
      deathFrameCount = 0;
      bestComboThisGame = 0;
      tokenSpawnTimer = 1.5;
      waveGrazesThisWave = 0;
      slowMo = 1.0;
      slowMoTarget = 1.0;
      shakeTrauma = 0;
      flashAlpha = 0;
      freezeFrames = 0;

      player.x = CW / 2; player.y = CH / 2;
      player.targetX = CW / 2; player.targetY = CH / 2;
      player.trail = [];
      player.alive = true;
      player.shieldTokens = 0;
      player.shieldCharged = false;
      player.shieldActive = false;
      player.shieldTimer = 0;
      player.shieldKillsThisActivation = 0;
      shieldFill.classList.remove('ss-charged');

      wave.number = 0;
      wave.state = 'IDLE';
      wave.timer = 3.0;
      wave.difficulty = 1.0;
      wave.announceAlpha = 0;
      beamWarnings = [];
      totalGrazesThisGame = 0;
      deathCracks = [];
      deathRainActive = false;
      magnetActive = false; magnetTimer = 0;
      timeWarpActive = false; timeWarpTimer = 0;
      comboBorderAlpha = 0;
      desatTimer = 0;
      minProjectileDist = CW;
      prevPlayerX = CW / 2; prevPlayerY = CH / 2;
      keysHeld.up = false; keysHeld.down = false; keysHeld.left = false; keysHeld.right = false;

      for (var i = 0; i < MAX_PROJECTILES; i++) { projectiles[i].active = false; projectiles[i].trailLen = 0; }
      for (var j = 0; j < MAX_PARTICLES; j++) particles[j].active = false;
      for (var k = 0; k < MAX_TOKENS; k++) tokenPool[k].active = false;
      for (var l = 0; l < MAX_FLOAT_TEXTS; l++) floatingTexts[l].active = false;
      for (var m = 0; m < 6; m++) shockwaves[m].active = false;
      for (var n = 0; n < 8; n++) { grazeFlashes[n].active = false; afterimages[n].active = false; }
    }

    function restartGame() {
      resetGame();
      startGame();
      updateHUD();
    }

    function togglePause() {
      if (gameState !== 'PLAYING' && gameState !== 'PAUSED') return;
      if (gameState === 'PLAYING') {
        gameState = 'PAUSED';
        overlay.classList.remove('ss-hidden', 'ss-start-screen', 'ss-dismissing');
        overlay.innerHTML = '<div class="ov-title">Paused</div><div class="ov-sub">P or Space to Resume</div>';
      } else {
        gameState = 'PLAYING';
        hideOverlay();
      }
    }

    // ── INPUT: MOUSE ────────────────────────────────────────────
    canvas.addEventListener('mousemove', function(e) {
      var rect = canvas.getBoundingClientRect();
      var scaleX = CW / rect.width;
      var scaleY = CH / rect.height;
      player.targetX = (e.clientX - rect.left) * scaleX;
      player.targetY = (e.clientY - rect.top) * scaleY;
    });

    canvas.addEventListener('click', function() {
      if (!audioCtx) try { getAudio(); } catch(err) {}
      if (gameState === 'MENU') startGame();
      else if (gameState === 'GAME_OVER') restartGame();
    });

    // ── INPUT: KEYBOARD ─────────────────────────────────────────
    document.addEventListener('keydown', function(e) {
      if (!audioCtx) try { getAudio(); } catch(err) {}
      checkKonami(e.key);

      switch (e.key) {
        case ' ':
          e.preventDefault();
          if (gameState === 'MENU') startGame();
          else if (gameState === 'GAME_OVER') restartGame();
          else if (gameState === 'PAUSED') togglePause();
          else if (gameState === 'PLAYING') activateShield();
          break;
        case 'ArrowUp': case 'w': case 'W': e.preventDefault(); keysHeld.up = true; break;
        case 'ArrowDown': case 's': case 'S': e.preventDefault(); keysHeld.down = true; break;
        case 'ArrowLeft': case 'a': case 'A': e.preventDefault(); keysHeld.left = true; break;
        case 'ArrowRight': case 'd': case 'D': e.preventDefault(); keysHeld.right = true; break;
        case 'p': case 'P':
          togglePause();
          break;
        case 'm': case 'M':
          musicEngine.toggle();
          break;
      }
    });

    document.addEventListener('keyup', function(e) {
      switch (e.key) {
        case 'ArrowUp': case 'w': case 'W': keysHeld.up = false; break;
        case 'ArrowDown': case 's': case 'S': keysHeld.down = false; break;
        case 'ArrowLeft': case 'a': case 'A': keysHeld.left = false; break;
        case 'ArrowRight': case 'd': case 'D': keysHeld.right = false; break;
      }
    });

    // ── INPUT: TOUCH ────────────────────────────────────────────
    var touchId = null;
    var touchStartTime = 0;
    var touchMoved = false;
    var touchStartX = 0, touchStartY = 0;

    canvas.addEventListener('touchstart', function(e) {
      e.preventDefault();
      if (!audioCtx) try { getAudio(); } catch(err) {}

      var t = e.touches[0];
      touchId = t.identifier;
      touchStartTime = Date.now();
      touchStartX = t.clientX;
      touchStartY = t.clientY;
      touchMoved = false;

      if (gameState === 'MENU') { startGame(); return; }
      if (gameState === 'GAME_OVER') { restartGame(); return; }

      updateTouchTarget(t);
    }, { passive: false });

    canvas.addEventListener('touchmove', function(e) {
      e.preventDefault();
      for (var i = 0; i < e.changedTouches.length; i++) {
        if (e.changedTouches[i].identifier === touchId) {
          var tdx = e.changedTouches[i].clientX - touchStartX;
          var tdy = e.changedTouches[i].clientY - touchStartY;
          if (tdx * tdx + tdy * tdy > 100) touchMoved = true; // 10px threshold
          updateTouchTarget(e.changedTouches[i]);
        }
      }
    }, { passive: false });

    canvas.addEventListener('touchend', function(e) {
      for (var i = 0; i < e.changedTouches.length; i++) {
        if (e.changedTouches[i].identifier === touchId) {
          var elapsed = Date.now() - touchStartTime;
          if (elapsed < 200 && !touchMoved) {
            activateShield();
          }
          touchId = null;
        }
      }
    }, { passive: true });

    function updateTouchTarget(touch) {
      var rect = canvas.getBoundingClientRect();
      var scaleX = CW / rect.width;
      var scaleY = CH / rect.height;
      player.targetX = (touch.clientX - rect.left) * scaleX;
      player.targetY = (touch.clientY - rect.top) * scaleY;
    }

    // ── RENDERING ───────────────────────────────────────────────
    function hexToRGBA(hex, alpha) {
      if (hex.startsWith('hsl') || hex.startsWith('rgb')) return hex;
      var r = 0, g = 0, b = 0;
      if (hex.length === 4) {
        r = parseInt(hex[1] + hex[1], 16); g = parseInt(hex[2] + hex[2], 16); b = parseInt(hex[3] + hex[3], 16);
      } else if (hex.length === 7) {
        r = parseInt(hex.substring(1, 3), 16); g = parseInt(hex.substring(3, 5), 16); b = parseInt(hex.substring(5, 7), 16);
      }
      return 'rgba(' + r + ',' + g + ',' + b + ',' + alpha + ')';
    }

    function drawOctagon(cx, cy, r, rotation) {
      ctx.beginPath();
      for (var i = 0; i < 8; i++) {
        var angle = rotation + (Math.PI * 2 / 8) * i - Math.PI / 8;
        var x = cx + r * Math.cos(angle);
        var y = cy + r * Math.sin(angle);
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      }
      ctx.closePath();
    }

    var vignetteGradient = ctx.createRadialGradient(CW / 2, CH / 2, CW * 0.28, CW / 2, CH / 2, CW * 0.75);
    vignetteGradient.addColorStop(0, 'rgba(0,0,0,0)');
    vignetteGradient.addColorStop(1, 'rgba(0,0,0,0.45)');

    var dangerGradient = ctx.createRadialGradient(CW / 2, CH / 2, CW * 0.2, CW / 2, CH / 2, CW * 0.7);
    dangerGradient.addColorStop(0, 'rgba(0,0,0,0)');
    dangerGradient.addColorStop(1, 'rgba(212,72,59,1)');

    function renderStartNodes(dt) {
      for (var i = 0; i < startNodes.length; i++) {
        var n = startNodes[i];
        // Mouse repulsion
        var ndx = n.x - player.targetX, ndy = n.y - player.targetY;
        var ndist = Math.sqrt(ndx * ndx + ndy * ndy);
        if (ndist < 100 && ndist > 1) {
          n.vx += (ndx / ndist) * 80 * dt;
          n.vy += (ndy / ndist) * 80 * dt;
        }
        var nspd = Math.sqrt(n.vx * n.vx + n.vy * n.vy);
        if (nspd > 40) { n.vx *= 40 / nspd; n.vy *= 40 / nspd; }
        n.x += n.vx * dt;
        n.y += n.vy * dt;
        if (n.x < 0 || n.x > CW) n.vx *= -1;
        if (n.y < 0 || n.y > CH) n.vy *= -1;
        n.x = Math.max(0, Math.min(CW, n.x));
        n.y = Math.max(0, Math.min(CH, n.y));
      }

      ctx.strokeStyle = hexToRGBA(COLORS.player, 0.08);
      ctx.lineWidth = 1;
      for (var i = 0; i < startNodes.length; i++) {
        for (var j = i + 1; j < startNodes.length; j++) {
          var dx = startNodes[i].x - startNodes[j].x;
          var dy = startNodes[i].y - startNodes[j].y;
          var dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 120) {
            ctx.globalAlpha = (1 - dist / 120) * 0.15;
            ctx.beginPath();
            ctx.moveTo(startNodes[i].x, startNodes[i].y);
            ctx.lineTo(startNodes[j].x, startNodes[j].y);
            ctx.stroke();
          }
        }
      }

      ctx.globalAlpha = 1;
      for (var i = 0; i < startNodes.length; i++) {
        var n = startNodes[i];
        ctx.fillStyle = hexToRGBA(COLORS.player, 0.2);
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    }

    function renderBgDots() {
      ctx.fillStyle = COLORS.dots;
      for (var i = 0; i < bgDots.length; i++) {
        var d = bgDots[i];
        var px = (player.x - CW / 2) * 0.04 * d.depth;
        var py = (player.y - CH / 2) * 0.04 * d.depth;
        ctx.globalAlpha = (0.3 + d.depth * 0.35) * (0.8 + 0.2 * Math.sin(gameTime * 2 + d.depth * 3));
        ctx.fillRect(d.x + px, d.y + py, d.size, d.size);
      }
      ctx.globalAlpha = 1;
    }

    function renderBeamWarnings() {
      for (var i = 0; i < beamWarnings.length; i++) {
        var bw = beamWarnings[i];
        var pulse = Math.sin(bw.timer * 15) * 0.3 + 0.5;
        ctx.strokeStyle = hexToRGBA(COLORS.projRed, pulse * 0.6);
        ctx.lineWidth = 2 + pulse * 2;
        ctx.setLineDash([8, 8]);
        ctx.beginPath();
        ctx.moveTo(bw.x1, bw.y1);
        ctx.lineTo(bw.x2, bw.y2);
        ctx.stroke();
        ctx.setLineDash([]);
      }
    }

    function renderProjectiles() {
      var trailAlphas = [0.45, 0.32, 0.22, 0.14, 0.08, 0.03];
      var trailScales = [0.88, 0.74, 0.60, 0.46, 0.32, 0.20];

      // Pass 1: Draw all trails (cheap fills, no shadowBlur)
      for (var i = 0; i < MAX_PROJECTILES; i++) {
        var p = projectiles[i];
        if (!p.active || p.trailLen === 0) continue;
        var tColor = timeWarpActive ? '#A78BFA' : p.color;
        for (var t = Math.min(p.trailLen, 6) - 1; t >= 0; t--) {
          ctx.globalAlpha = trailAlphas[t];
          ctx.fillStyle = tColor;
          ctx.beginPath();
          ctx.arc(p.trailX[t], p.trailY[t], p.radius * trailScales[t], 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;

      // Pass 2: Batch all heads by color with single shadowBlur call
      var redPath = new Path2D();
      var heavyPath = new Path2D();
      var warpPath = new Path2D();
      for (var j = 0; j < MAX_PROJECTILES; j++) {
        var p2 = projectiles[j];
        if (!p2.active) continue;
        var path = timeWarpActive ? warpPath : (p2.color === COLORS.projHeavy ? heavyPath : redPath);
        path.moveTo(p2.x + p2.radius, p2.y);
        path.arc(p2.x, p2.y, p2.radius, 0, Math.PI * 2);
      }
      ctx.save();
      ctx.shadowBlur = 8;
      if (!timeWarpActive) {
        ctx.shadowColor = COLORS.projRed; ctx.fillStyle = COLORS.projRed;
        ctx.fill(redPath);
        ctx.shadowColor = COLORS.projHeavy; ctx.fillStyle = COLORS.projHeavy;
        ctx.fill(heavyPath);
      } else {
        ctx.shadowColor = '#A78BFA'; ctx.fillStyle = '#A78BFA';
        ctx.fill(warpPath);
      }
      ctx.restore();
    }

    var POWER_COLORS = { normal: COLORS.tokenGold, magnet: '#22D3EE', timewarp: '#A78BFA', scoreburst: '#F1EDE4' };

    function renderTokens() {
      for (var i = 0; i < MAX_TOKENS; i++) {
        var tk = tokenPool[i];
        if (!tk.active) continue;

        var tColor = POWER_COLORS[tk.powerType] || COLORS.tokenGold;
        var pulseR = tk.powerType !== 'normal' ? tk.radius * (1 + 0.15 * Math.sin(gameTime * 6)) : tk.radius;

        ctx.save();
        ctx.shadowColor = tColor;
        ctx.shadowBlur = 15 + Math.sin(gameTime * 4) * 8;
        ctx.fillStyle = tColor;

        if (tk.powerType !== 'normal') {
          // Diamond shape for power-ups
          ctx.beginPath();
          var dr = pulseR;
          ctx.moveTo(tk.x, tk.y - dr); ctx.lineTo(tk.x + dr, tk.y);
          ctx.lineTo(tk.x, tk.y + dr); ctx.lineTo(tk.x - dr, tk.y);
          ctx.closePath(); ctx.fill();
        } else {
          drawOctagon(tk.x, tk.y, pulseR, tk.rotation);
          ctx.fill();
        }
        ctx.restore();

        for (var s = 0; s < 3; s++) {
          var sparkAngle = tk.rotation * 2 + (Math.PI * 2 / 3) * s;
          var sx = tk.x + (pulseR + 6) * Math.cos(sparkAngle);
          var sy = tk.y + (pulseR + 6) * Math.sin(sparkAngle);
          ctx.fillStyle = tk.powerType !== 'normal' ? tColor : COLORS.tokenSparkle;
          ctx.globalAlpha = 0.5 + Math.sin(gameTime * 8 + s) * 0.3;
          ctx.beginPath();
          ctx.arc(sx, sy, 1.5, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
      }
    }

    function renderPlayer() {
      if (!player.alive && gameState !== 'DYING') return;

      var col = getPlayerColor(gameTime);

      // Trail
      for (var i = player.trail.length - 1; i >= 0; i--) {
        var t = player.trail[i];
        var alpha = (1 - i / TRAIL_LENGTH) * 0.3;
        ctx.fillStyle = hexToRGBA(col.startsWith && col.startsWith('hsl') ? COLORS.player : col, alpha);
        ctx.beginPath();
        ctx.arc(t.x, t.y, player.radius * (1 - i / TRAIL_LENGTH * 0.3), 0, Math.PI * 2);
        ctx.fill();
      }

      // Main body
      if (player.alive || gameState === 'DYING') {
        ctx.save();
        ctx.shadowColor = COLORS.playerGlow;
        ctx.shadowBlur = 18;
        ctx.fillStyle = col;
        ctx.beginPath();
        ctx.arc(player.x, player.y, player.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();

        // Inner glow
        ctx.fillStyle = hexToRGBA(COLORS.playerGlow, 0.4);
        ctx.beginPath();
        ctx.arc(player.x, player.y, player.radius * 0.5, 0, Math.PI * 2);
        ctx.fill();
      }

      // Shield ring
      if (player.shieldActive) {
        var shieldAlpha = 0.4 + Math.sin(gameTime * 10) * 0.2;
        var shieldProg = player.shieldTimer / SHIELD_DURATION;
        ctx.strokeStyle = hexToRGBA(COLORS.shield, shieldAlpha * shieldProg);
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.arc(player.x, player.y, SHIELD_RADIUS, 0, Math.PI * 2);
        ctx.stroke();

        // Inner glow ring
        ctx.strokeStyle = hexToRGBA(COLORS.playerGlow, shieldAlpha * shieldProg * 0.3);
        ctx.lineWidth = 8;
        ctx.beginPath();
        ctx.arc(player.x, player.y, SHIELD_RADIUS - 4, 0, Math.PI * 2);
        ctx.stroke();
      }
    }

    function renderParticles() {
      for (var i = 0; i < MAX_PARTICLES; i++) {
        var p = particles[i];
        if (!p.active) continue;
        var alpha = Math.max(0, p.life / p.maxLife);
        ctx.globalAlpha = alpha;
        ctx.fillStyle = p.color;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size * alpha, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    }

    function renderFloatingTexts() {
      for (var i = 0; i < MAX_FLOAT_TEXTS; i++) {
        var f = floatingTexts[i];
        if (!f.active) continue;
        var alpha = Math.max(0, f.life / f.maxLife);
        ctx.save();
        ctx.globalAlpha = alpha;
        ctx.fillStyle = f.color;
        ctx.font = 'bold ' + Math.round(f.size * f.scale) + 'px sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.shadowColor = f.color;
        ctx.shadowBlur = 8;
        ctx.fillText(f.text, f.x, f.y);
        ctx.restore();
      }
    }

    function renderWaveAnnounce() {
      if (wave.state !== 'ANNOUNCE' && wave.announceAlpha <= 0) return;
      ctx.save();
      ctx.globalAlpha = wave.announceAlpha;
      ctx.fillStyle = COLORS.text;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.font = 'bold ' + Math.round(24 * wave.announceScale) + 'px sans-serif';
      ctx.shadowColor = COLORS.player;
      ctx.shadowBlur = 15;
      ctx.fillText('WAVE ' + wave.number, CW / 2, CH / 2 - 18);
      ctx.font = '600 ' + Math.round(16 * wave.announceScale) + 'px sans-serif';
      ctx.fillStyle = COLORS.player;
      ctx.fillText(wave.name, CW / 2, CH / 2 + 12);
      ctx.restore();
    }

    function renderDangerVignette() {
      var dangerAlpha = Math.max(0, 1 - minProjectileDist / 150) * 0.15;

      ctx.fillStyle = vignetteGradient;
      ctx.fillRect(0, 0, CW, CH);

      if (dangerAlpha > 0.01) {
        ctx.globalAlpha = dangerAlpha;
        ctx.fillStyle = dangerGradient;
        ctx.fillRect(0, 0, CW, CH);
        ctx.globalAlpha = 1;
      }

      // Screen-edge danger indicators
      var edgeAlpha = [0, 0, 0, 0]; // top, right, bottom, left
      for (var i = 0; i < MAX_PROJECTILES; i++) {
        var p = projectiles[i];
        if (!p.active) continue;
        var em = 60;
        if (p.y < em) edgeAlpha[0] = Math.max(edgeAlpha[0], (1 - p.y / em) * 0.5);
        if (p.x > CW - em) edgeAlpha[1] = Math.max(edgeAlpha[1], (1 - (CW - p.x) / em) * 0.5);
        if (p.y > CH - em) edgeAlpha[2] = Math.max(edgeAlpha[2], (1 - (CH - p.y) / em) * 0.5);
        if (p.x < em) edgeAlpha[3] = Math.max(edgeAlpha[3], (1 - p.x / em) * 0.5);
      }
      for (var e = 0; e < 4; e++) {
        if (edgeAlpha[e] < 0.02) continue;
        var eg;
        if (e === 0) { eg = ctx.createLinearGradient(0, 0, 0, 20); }
        else if (e === 1) { eg = ctx.createLinearGradient(CW, 0, CW - 20, 0); }
        else if (e === 2) { eg = ctx.createLinearGradient(0, CH, 0, CH - 20); }
        else { eg = ctx.createLinearGradient(0, 0, 20, 0); }
        eg.addColorStop(0, 'rgba(212,72,59,' + edgeAlpha[e] + ')');
        eg.addColorStop(1, 'rgba(212,72,59,0)');
        ctx.fillStyle = eg;
        if (e === 0) ctx.fillRect(0, 0, CW, 20);
        else if (e === 1) ctx.fillRect(CW - 20, 0, 20, CH);
        else if (e === 2) ctx.fillRect(0, CH - 20, CW, 20);
        else ctx.fillRect(0, 0, 20, CH);
      }

      // Danger letterbox
      var lbH = Math.max(0, 1 - minProjectileDist / 100) * 15;
      if (lbH > 0.5) {
        ctx.fillStyle = 'rgba(0,0,0,0.5)';
        ctx.fillRect(0, 0, CW, lbH);
        ctx.fillRect(0, CH - lbH, CW, lbH);
      }
    }

    function render(dt) {
      var isIdle = gameState === 'MENU' || gameState === 'PAUSED' || gameState === 'GAME_OVER';
      var shake = isIdle ? { x: 0, y: 0 } : getShakeOffset();
      frameCount++;

      ctx.save();
      ctx.translate(shake.x, shake.y);

      if (isIdle && !deathRainActive) {
        ctx.clearRect(-20, -20, CW + 40, CH + 40);
        ctx.fillStyle = COLORS.bg;
        ctx.fillRect(0, 0, CW, CH);
      } else {
        if (frameCount % 120 === 0) {
          ctx.clearRect(-20, -20, CW + 40, CH + 40);
        }
        ctx.fillStyle = hexToRGBA(COLORS.bg, deathRainActive && isIdle ? 0.12 : 0.18);
        ctx.fillRect(-20, -20, CW + 40, CH + 40);
      }

      if (gameState === 'MENU') {
        renderStartNodes(dt);
      }

      if (gameState === 'PLAYING' || gameState === 'DYING') {
        renderBgDots();
        renderBeamWarnings();
        renderProjectiles();
        renderTokens();

        // Player afterimages (speed-based)
        for (var ai = afterimages.length - 1; ai >= 0; ai--) {
          var aim = afterimages[ai];
          if (!aim.active) continue;
          ctx.globalAlpha = aim.alpha;
          ctx.fillStyle = hexToRGBA(COLORS.playerGlow, 0.6);
          ctx.beginPath();
          ctx.arc(aim.x, aim.y, player.radius * (0.6 + aim.alpha * 0.4), 0, Math.PI * 2);
          ctx.fill();
          aim.alpha -= dt * 4;
          if (aim.alpha <= 0) aim.active = false;
        }
        ctx.globalAlpha = 1;

        renderPlayer();

        // Shockwaves
        for (var si = 0; si < 6; si++) {
          var sw = shockwaves[si];
          if (!sw.active) continue;
          ctx.strokeStyle = hexToRGBA(sw.color, sw.alpha);
          ctx.lineWidth = sw.lineWidth;
          ctx.beginPath();
          ctx.arc(sw.x, sw.y, sw.radius, 0, Math.PI * 2);
          ctx.stroke();
        }

        // Graze flash lines
        for (var gfr = 0; gfr < 8; gfr++) {
          var gf = grazeFlashes[gfr];
          if (!gf.active) continue;
          ctx.strokeStyle = 'rgba(255,248,231,' + gf.alpha + ')';
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(gf.x1, gf.y1);
          ctx.lineTo(gf.x2, gf.y2);
          ctx.stroke();
        }

        // Death cracks
        for (var dc = 0; dc < deathCracks.length; dc++) {
          var crack = deathCracks[dc];
          if (crack.alpha < 0.02) continue;
          ctx.strokeStyle = 'rgba(255,255,255,' + crack.alpha + ')';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(crack.x1, crack.y1);
          ctx.lineTo(crack.x2, crack.y2);
          ctx.stroke();
          crack.alpha *= 0.97;
        }

        renderParticles();
        renderFloatingTexts();
        renderWaveAnnounce();
        renderDangerVignette();

        // Combo border glow
        if (comboBorderAlpha > 0.01) {
          ctx.strokeStyle = hexToRGBA(COLORS.player, comboBorderAlpha);
          ctx.lineWidth = 2;
          ctx.strokeRect(2, 2, CW - 4, CH - 4);
        }

        // Combo particle rain (x6+)
        if (comboCount >= 6 && gameState === 'PLAYING') {
          spawnParticle(Math.random() * CW, -3, COLORS.player, 0, 30 + Math.random() * 20, 1, 2.5);
        }

        // Desat pop
        if (desatTimer > 0) {
          ctx.fillStyle = 'rgba(20,18,14,0.12)';
          ctx.fillRect(0, 0, CW, CH);
          desatTimer -= dt;
        }

        // Power-up HUD indicator
        if (magnetActive || timeWarpActive) {
          var puColor = magnetActive ? '#22D3EE' : '#A78BFA';
          var puTime = magnetActive ? magnetTimer : timeWarpTimer;
          var puMax = 3.0;
          ctx.fillStyle = hexToRGBA(puColor, 0.7);
          ctx.fillRect(CW - 60, 8, 50 * (puTime / puMax), 4);
          ctx.strokeStyle = hexToRGBA(puColor, 0.3);
          ctx.lineWidth = 1;
          ctx.strokeRect(CW - 60, 8, 50, 4);
        }
      } else if (gameState === 'GAME_OVER') {
        renderBgDots();
        // Game over particle rain
        if (deathRainActive) {
          spawnParticle(Math.random() * CW, -3, COLORS.player, (Math.random() - 0.5) * 10, 25 + Math.random() * 15, 1.2, 3.0);
        }
        renderParticles();
        renderFloatingTexts();
      } else if (gameState === 'PAUSED') {
        renderBgDots();
        renderProjectiles();
        renderTokens();
        renderPlayer();
      }

      if (flashAlpha > 0.005) {
        ctx.fillStyle = hexToRGBA(flashColor, flashAlpha);
        ctx.fillRect(-20, -20, CW + 40, CH + 40);
        flashAlpha *= 0.88;
      } else {
        flashAlpha = 0;
      }

      ctx.restore();
    }

    // ── HUD ─────────────────────────────────────────────────────
    var lastHudScore = -1, lastHudBest = -1, lastHudWave = -1, lastHudCombo = -1;

    function updateHUD() {
      if (score !== lastHudScore) { scoreEl.textContent = score; lastHudScore = score; }
      if (stats.highScore !== lastHudBest) { bestEl.textContent = stats.highScore; lastHudBest = stats.highScore; }
      var wn = wave.number || 0;
      if (wn !== lastHudWave) { waveEl.textContent = wn > 0 ? wn : '\u2013'; lastHudWave = wn; }
      var cc = comboCount >= 2 ? 'x' + comboCount : '\u2013';
      if (cc !== lastHudCombo) { comboEl.textContent = cc; lastHudCombo = cc; }

      var shieldPct = player.shieldActive
        ? (player.shieldTimer / SHIELD_DURATION) * 100
        : (player.shieldTokens / SHIELD_CHARGE_NEEDED) * 100;
      shieldFill.style.width = Math.min(100, shieldPct) + '%';

      streakDisplay.textContent = stats.currentStreak > 0 ? '\uD83D\uDD25 ' + stats.currentStreak + ' day streak' : '';
    }

    // ── SKIN SELECTOR ───────────────────────────────────────────
    function buildSkinSelector() {
      skinContainer.innerHTML = '';
      Object.keys(SKINS).forEach(function(key) {
        var sk = SKINS[key];
        var el = document.createElement('div');
        el.className = 'ss-skin-circle';
        el.title = sk.name + (sk.req ? ' (' + sk.req + ')' : '');
        var unlocked = isSkinUnlocked(key);
        if (!unlocked) {
          el.classList.add('ss-locked');
        } else {
          var displayColor = sk.color === 'rainbow' ? '#ff00ff' : sk.color;
          el.style.background = displayColor;
          if (key === activeSkin) el.classList.add('ss-active');
          el.addEventListener('click', function() {
            activeSkin = key;
            stats.activeSkin = key;
            saveStats();
            buildSkinSelector();
          });
        }
        skinContainer.appendChild(el);
      });
    }

    // ── STATS PANEL ─────────────────────────────────────────────
    function statBox(label, val) {
      return '<div class="ss-stat-box"><div class="ss-stat-label">' + label + '</div><div class="ss-stat-value">' + val + '</div></div>';
    }

    function renderStatsPanel() {
      statsPanel.innerHTML = '<h3>Lifetime Stats</h3><div class="ss-stats-grid">' +
        statBox('Games Played', stats.totalGames) +
        statBox('High Score', stats.highScore) +
        statBox('Longest Survival', Math.floor(stats.longestSurvival) + 's') +
        statBox('Tokens Collected', stats.totalTokens) +
        statBox('Total Grazes', stats.totalGrazes) +
        statBox('Longest Combo', stats.longestCombo) +
        statBox('Shield Kills', stats.totalShieldKills) +
        statBox('Current Streak', stats.currentStreak + ' days') +
        statBox('Best Streak', stats.longestStreak + ' days') +
        '</div>';
    }

    function renderAchPanel() {
      var html = '<h3>Achievements</h3><div class="ss-ach-grid">';
      Object.keys(ACHIEVEMENTS).forEach(function(key) {
        var a = ACHIEVEMENTS[key];
        var earned = stats.achievements[key] ? ' ss-earned' : '';
        html += '<div class="ss-ach-item' + earned + '"><span class="ss-ach-icon">' + a.icon +
          '</span><div class="ss-ach-info"><span class="ss-ach-name">' + a.name +
          '</span><span class="ss-ach-desc">' + a.desc + '</span></div></div>';
      });
      html += '</div>';
      achPanel.innerHTML = html;
    }

    statsBtn.addEventListener('click', function() {
      renderStatsPanel();
      statsPanel.classList.toggle('ss-visible');
      achPanel.classList.remove('ss-visible');
    });
    achBtn.addEventListener('click', function() {
      renderAchPanel();
      achPanel.classList.toggle('ss-visible');
      statsPanel.classList.remove('ss-visible');
    });

    // ── GAME LOOP ───────────────────────────────────────────────
    var lastTime = 0;

    function gameLoop(timestamp) {
      var realDt = (timestamp - lastTime) / 1000;
      if (realDt > 0.1) realDt = 0.1;
      lastTime = timestamp;

      slowMo += (slowMoTarget - slowMo) * 0.12;
      var gameDt = realDt * slowMo;
      gameTime += realDt;

      // Music scheduling + slow-mo audio
      if (musicEngine.playing) {
        musicEngine.scheduleBeat();
        musicEngine.updateSlowMo(slowMo);
        musicEngine.updateHeartbeat(minProjectileDist);
      }

      if (freezeFrames > 0) {
        freezeFrames--;
        render(realDt);
        requestAnimationFrame(gameLoop);
        return;
      }

      if (gameState === 'PLAYING') {
        survivalTime += gameDt;

        // Keyboard target movement (uses realDt so slow-mo doesn't penalize input)
        if (keysHeld.up) player.targetY -= KEYBOARD_SPEED * realDt;
        if (keysHeld.down) player.targetY += KEYBOARD_SPEED * realDt;
        if (keysHeld.left) player.targetX -= KEYBOARD_SPEED * realDt;
        if (keysHeld.right) player.targetX += KEYBOARD_SPEED * realDt;
        player.targetX = Math.max(player.radius, Math.min(CW - player.radius, player.targetX));
        player.targetY = Math.max(player.radius, Math.min(CH - player.radius, player.targetY));

        // Player movement (85% easing)
        var ease = 1 - Math.pow(0.15, realDt * 60);
        player.x += (player.targetX - player.x) * ease;
        player.y += (player.targetY - player.y) * ease;
        player.x = Math.max(player.radius, Math.min(CW - player.radius, player.x));
        player.y = Math.max(player.radius, Math.min(CH - player.radius, player.y));

        // Trail
        player.trail.unshift({ x: player.x, y: player.y });
        if (player.trail.length > TRAIL_LENGTH) player.trail.pop();

        // Combo timer
        if (comboTimer > 0) {
          comboTimer -= gameDt;
          if (comboTimer <= 0) { comboCount = 0; comboTimer = 0; }
        }

        // Player speed afterimage
        var pspd = Math.sqrt(Math.pow(player.x - prevPlayerX, 2) + Math.pow(player.y - prevPlayerY, 2)) / (realDt || 0.016);
        if (pspd > 150) {
          for (var aai = 0; aai < 8; aai++) {
            if (!afterimages[aai].active) {
              afterimages[aai].active = true; afterimages[aai].x = player.x; afterimages[aai].y = player.y; afterimages[aai].alpha = 0.5;
              break;
            }
          }
        }
        prevPlayerX = player.x; prevPlayerY = player.y;

        var timeWarpMult = timeWarpActive ? 0.5 : 1.0;
        updateWaves(gameDt);
        updateProjectiles(gameDt * timeWarpMult);
        updateTokens(gameDt);
        updateTokenSpawning(gameDt);
        updateShield(realDt);
        updatePowerUps(gameDt);
        checkCollisions();
        updateHUD();
      }

      if (gameState === 'DYING') {
        deathFrameCount++;
        player.x += (player.targetX - player.x) * 0.02;
        player.y += (player.targetY - player.y) * 0.02;
        updateProjectiles(gameDt);
        // Death particle rain
        if (deathFrameCount % 2 === 0) {
          spawnParticle(Math.random() * CW, -3, COLORS.player, (Math.random() - 0.5) * 10, 25 + Math.random() * 15, 1.2, 2.5);
        }
        if (deathFrameCount >= 90) {
          endGame();
        }
      }

      updateParticles(realDt);
      updateFloatingTexts(realDt);
      updateShockwaves(realDt);
      updateGrazeFlashes();
      if (comboBorderAlpha > 0 && comboTimer <= 0) comboBorderAlpha *= 0.95;
      render(realDt);

      requestAnimationFrame(gameLoop);
    }

    // ── INITIALIZATION ──────────────────────────────────────────
    resetGame();
    updateStreak();
    buildSkinSelector();
    showStartScreen();
    updateHUD();
    bestEl.textContent = stats.highScore;

    ctx.fillStyle = COLORS.bg;
    ctx.fillRect(0, 0, CW, CH);
    render(0);

    requestAnimationFrame(function(ts) {
      lastTime = ts;
      gameLoop(ts);
    });

    })();
  </script>
</Layout>
