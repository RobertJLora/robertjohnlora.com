    // ── MUSIC ENGINE (4-LAYER SYSTEM) ─────────────────────────
    var musicEngine = {
      playing: false,
      masterGain: null,
      oscillators: [],
      layerGains: [null, null, null, null],
      layerTargets: [0.05, 0, 0, 0],
      heartbeatOsc: null, heartbeatLFO: null, heartbeatGain: null,
      beatInterval: 60 / 90,
      nextBeatTime: 0,
      hihatBuffer: null,
      melodyNotes: [220, 262, 330, 440],
      melodyIndex: 0,
      _generation: 0,
      _stopTimeout: null,

      start: function() {
        if (this.playing) return;
        if (this._stopTimeout) { clearTimeout(this._stopTimeout); this._stopTimeout = null; }
        var a = getAudio(), t = a.currentTime;
        this.playing = true;
        this.oscillators = [];

        this.masterGain = a.createGain();
        this.masterGain.gain.setValueAtTime(0, t);
        this.masterGain.gain.linearRampToValueAtTime(1, t + 2);
        this.masterGain.connect(a.destination);

        // Layer 1: Drone pad (always on)
        this.layerGains[0] = a.createGain();
        this.layerGains[0].gain.setValueAtTime(0.05, t);
        var padFilter = a.createBiquadFilter();
        padFilter.type = 'lowpass'; padFilter.frequency.setValueAtTime(250, t); padFilter.Q.setValueAtTime(1, t);
        padFilter.connect(this.layerGains[0]); this.layerGains[0].connect(this.masterGain);
        var padLFO = a.createOscillator(); padLFO.type = 'sine'; padLFO.frequency.setValueAtTime(0.06, t);
        var padLFOG = a.createGain(); padLFOG.gain.setValueAtTime(120, t);
        padLFO.connect(padLFOG); padLFOG.connect(padFilter.frequency); padLFO.start();
        var g1 = a.createGain(); g1.gain.setValueAtTime(1, t); g1.connect(padFilter);
        var osc1 = a.createOscillator(); osc1.type = 'sawtooth'; osc1.frequency.setValueAtTime(55, t); osc1.detune.setValueAtTime(-8, t);
        osc1.connect(g1); osc1.start();
        var g2 = a.createGain(); g2.gain.setValueAtTime(0.7, t); g2.connect(padFilter);
        var osc2 = a.createOscillator(); osc2.type = 'sawtooth'; osc2.frequency.setValueAtTime(55, t); osc2.detune.setValueAtTime(8, t);
        osc2.connect(g2); osc2.start();
        this.oscillators.push(osc1, osc2, padLFO);

        // Layer 2: Hi-hat (wave 3+)
        this.layerGains[1] = a.createGain();
        this.layerGains[1].gain.setValueAtTime(0, t);
        this.layerGains[1].connect(this.masterGain);
        var bufLen = a.sampleRate * 0.02;
        this.hihatBuffer = a.createBuffer(1, bufLen, a.sampleRate);
        var hdata = this.hihatBuffer.getChannelData(0);
        for (var hi = 0; hi < bufLen; hi++) hdata[hi] = Math.random() * 2 - 1;

        // Layer 3: Bass pulse (wave 6+)
        this.layerGains[2] = a.createGain();
        this.layerGains[2].gain.setValueAtTime(0, t);
        this.layerGains[2].connect(this.masterGain);
        var bassOsc = a.createOscillator(); bassOsc.type = 'sine'; bassOsc.frequency.setValueAtTime(55, t);
        var bassEnvGain = a.createGain(); bassEnvGain.gain.setValueAtTime(0, t);
        bassOsc.connect(bassEnvGain); bassEnvGain.connect(this.layerGains[2]);
        bassOsc.start(); this.oscillators.push(bassOsc);
        this._bassEnvGain = bassEnvGain;

        // Layer 4: Melody (wave 10+)
        this.layerGains[3] = a.createGain();
        this.layerGains[3].gain.setValueAtTime(0, t);
        this.layerGains[3].connect(this.masterGain);
        this.melodyIndex = 0;

        // Heartbeat (proximity-based)
        this.heartbeatGain = a.createGain();
        this.heartbeatGain.gain.setValueAtTime(0, t);
        this.heartbeatGain.connect(this.masterGain);
        this.heartbeatOsc = a.createOscillator(); this.heartbeatOsc.type = 'sine';
        this.heartbeatOsc.frequency.setValueAtTime(40, t);
        this.heartbeatLFO = a.createOscillator(); this.heartbeatLFO.type = 'sine';
        this.heartbeatLFO.frequency.setValueAtTime(1.5, t);
        var hbLFOGain = a.createGain(); hbLFOGain.gain.setValueAtTime(0.04, t);
        this.heartbeatLFO.connect(hbLFOGain); hbLFOGain.connect(this.heartbeatGain.gain);
        this.heartbeatOsc.connect(this.heartbeatGain);
        this.heartbeatOsc.start(); this.heartbeatLFO.start();
        this.oscillators.push(this.heartbeatOsc, this.heartbeatLFO);

        this.nextBeatTime = t + this.beatInterval;
        this.layerTargets = [0.05, 0, 0, 0];
      },

      scheduleBeat: function() {
        if (!this.playing) return;
        try {
          var a = getAudio(), now = a.currentTime;
          // Skip ahead if tab was inactive
          if (this.nextBeatTime < now - 2) this.nextBeatTime = now;
          var maxBeats = 4;
          while (this.nextBeatTime < now + 0.1 && maxBeats-- > 0) {
            var bt = this.nextBeatTime;

            // Hi-hat hit
            if (this.layerGains[1] && this.layerGains[1].gain.value > 0.001) {
              var src = a.createBufferSource(); src.buffer = this.hihatBuffer;
              var hp = a.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.setValueAtTime(6000, bt);
              var hg = a.createGain(); hg.gain.setValueAtTime(1, bt);
              hg.gain.exponentialRampToValueAtTime(0.001, bt + 0.04);
              src.connect(hp); hp.connect(hg); hg.connect(this.layerGains[1]);
              src.start(bt); src.stop(bt + 0.05);
            }

            // Bass pulse
            if (this._bassEnvGain && this.layerGains[2] && this.layerGains[2].gain.value > 0.001) {
              this._bassEnvGain.gain.setValueAtTime(0.8, bt);
              this._bassEnvGain.gain.exponentialRampToValueAtTime(0.01, bt + 0.3);
            }

            // Melody note
            if (this.layerGains[3] && this.layerGains[3].gain.value > 0.001) {
              var freq = this.melodyNotes[this.melodyIndex % this.melodyNotes.length];
              this.melodyIndex++;
              var mo = a.createOscillator(); mo.type = 'sine'; mo.frequency.setValueAtTime(freq, bt);
              mo.detune.setValueAtTime(5, bt);
              var mg = a.createGain(); mg.gain.setValueAtTime(0.5, bt);
              mg.gain.exponentialRampToValueAtTime(0.001, bt + 0.3);
              mo.connect(mg); mg.connect(this.layerGains[3]);
              mo.start(bt); mo.stop(bt + 0.35);
            }

            this.nextBeatTime += this.beatInterval;
          }
        } catch(e) {}
      },

      setWave: function(waveNum) {
        if (!this.playing) return;
        try {
          var a = getAudio(), t = a.currentTime;
          if (waveNum >= 3 && this.layerGains[1]) this.layerGains[1].gain.linearRampToValueAtTime(0.04, t + 4);
          if (waveNum >= 6 && this.layerGains[2]) this.layerGains[2].gain.linearRampToValueAtTime(0.06, t + 4);
          if (waveNum >= 10 && this.layerGains[3]) this.layerGains[3].gain.linearRampToValueAtTime(0.03, t + 4);
        } catch(e) {}
      },

      updateHeartbeat: function(dist) {
        if (!this.playing || !this.heartbeatGain) return;
        try {
          var targetGain = Math.max(0, 1 - dist / 120) * 0.08;
          this.heartbeatGain.gain.setTargetAtTime(targetGain, getAudio().currentTime, 0.05);
        } catch(e) {}
      },

      updateSlowMo: function(slowVal) {
        if (!this.playing) return;
        try {
          var a = getAudio(), t = a.currentTime;
          var detune = (slowVal - 1.0) * 400;
          var gainMod = 0.7 + slowVal * 0.3;
          for (var i = 0; i < this.oscillators.length; i++) {
            if (this.oscillators[i] && this.oscillators[i].detune) {
              this.oscillators[i].detune.setTargetAtTime(detune, t, 0.08);
            }
          }
          if (this.masterGain) this.masterGain.gain.setTargetAtTime(gainMod, t, 0.08);
        } catch(e) {}
      },

      stop: function() {
        if (!this.playing) return;
        this.playing = false;
        var gen = ++this._generation;
        try {
          var a = getAudio();
          if (this.masterGain) this.masterGain.gain.linearRampToValueAtTime(0, a.currentTime + 1);
        } catch(e) {}
        var self = this;
        this._stopTimeout = setTimeout(function() {
          self._stopTimeout = null;
          if (self._generation !== gen) return;
          for (var i = 0; i < self.oscillators.length; i++) {
            try { self.oscillators[i].stop(); } catch(e) {}
          }
          try { if (self.masterGain) self.masterGain.disconnect(); } catch(e) {}
          self.masterGain = null; self.oscillators = [];
          self.layerGains = [null, null, null, null];
          self.heartbeatOsc = null; self.heartbeatLFO = null; self.heartbeatGain = null;
          self._bassEnvGain = null;
        }, 1100);
      },

      toggle: function() {
        if (this.playing) { this.stop(); stats.musicMuted = true; }
        else { this.start(); stats.musicMuted = false; }
        saveStats();
      }
    };

    // ── OBJECT POOLS ────────────────────────────────────────────
