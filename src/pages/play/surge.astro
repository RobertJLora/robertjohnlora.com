---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="SERP Surge"
  description="Dodge algorithm updates, collect ranking boosts, activate your authority shield. A wave survival game for SEOs."
  currentSlug="play"
>
  <div class="note-content">
    <p class="back-link"><a href="/play">&larr; back to play</a></p>
  </div>

  <div class="surge-game">
    <div class="ss-container">
      <h1 class="ss-title">SERP <span class="ss-title-accent">Surge</span></h1>

      <div class="ss-game-panel">
        <div class="ss-score-bar">
          <div class="ss-score-item"><span class="ss-label">Score</span><span id="ss-score" class="ss-value">0</span></div>
          <div class="ss-score-item"><span class="ss-label">Best</span><span id="ss-best" class="ss-value">0</span></div>
          <div class="ss-score-item"><span class="ss-label">Wave</span><span id="ss-wave" class="ss-value">&ndash;</span></div>
          <div class="ss-score-item"><span class="ss-label">Combo</span><span id="ss-combo" class="ss-value">&ndash;</span></div>
        </div>

        <div class="ss-canvas-wrapper">
          <canvas id="ss-game" width="480" height="480"></canvas>
          <div id="ss-overlay" class="ss-start-screen"></div>
          <div id="ss-achievement-toast" class="ss-toast">
            <span class="ss-toast-icon"></span>
            <div class="ss-toast-text">
              <span class="ss-toast-name"></span>
              <span class="ss-toast-desc"></span>
            </div>
          </div>
        </div>

        <div class="ss-shield-bar-wrapper">
          <span class="ss-shield-label">Authority Shield</span>
          <div class="ss-shield-track">
            <div id="ss-shield-fill" class="ss-shield-fill"></div>
          </div>
        </div>

        <p class="ss-controls-hint" id="ss-controls">Mouse to move &middot; Space shield &middot; P pause &middot; M music</p>

        <div class="ss-skin-selector" id="ss-skins"></div>
      </div>

      <div class="ss-meta-bar">
        <button id="ss-stats-btn" class="ss-meta-btn">Stats</button>
        <button id="ss-ach-btn" class="ss-meta-btn">Achievements</button>
        <span id="ss-streak-display" class="ss-streak"></span>
      </div>

      <div id="ss-stats-panel" class="ss-panel"></div>
      <div id="ss-ach-panel" class="ss-panel"></div>

      <div id="ss-milestone-msg"></div>
    </div>
  </div>

  <style>
    .back-link { margin-bottom: 1rem; }
    .back-link a { font-size: 13px; color: var(--text-muted); text-decoration: none; }
    .back-link a:hover { color: var(--amber-accent); }
  </style>

  <style is:global>
    @keyframes ssFadeSlideUp {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes ssPulseGlow {
      0%, 100% { text-shadow: 0 0 6px rgba(232, 168, 54, 0.2); }
      50% { text-shadow: 0 0 18px rgba(232, 168, 54, 0.5), 0 0 36px rgba(245, 200, 66, 0.15); }
    }
    @keyframes ssOverlayDismiss {
      0% { opacity: 1; transform: scale(1); }
      100% { opacity: 0; transform: scale(1.06); }
    }
    @keyframes ssScoreDrop {
      0% { opacity: 0; transform: translateY(-40px) scale(0.5); }
      60% { opacity: 1; transform: translateY(8px) scale(1.05); }
      80% { opacity: 1; transform: translateY(-3px) scale(0.98); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes ssFadeUp {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes ssRankBar {
      from { width: 0; }
    }
    @keyframes ssShieldPulse {
      0%, 100% { opacity: 0.6; }
      50% { opacity: 1; }
    }
    @keyframes ssNodeDrift {
      0%, 100% { transform: translate(0, 0); }
      25% { transform: translate(2px, -3px); }
      50% { transform: translate(-1px, 2px); }
      75% { transform: translate(3px, 1px); }
    }

    .surge-game {
      --ss-bg: #0C0A08;
      --ss-bg2: #1A1610;
      --ss-bg3: #2A2418;
      --ss-border: #3A3428;
      --ss-text: #F1EDE4;
      --ss-text2: #A89E8C;
      --ss-muted: #6B6252;
      --ss-amber: #E8A836;
      --ss-amber-glow: #FFF8E7;
      --ss-red: #D4483B;
      --ss-gold: #F5C842;

      background-color: var(--ss-bg);
      color: var(--ss-text);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      border-radius: 16px;
      margin-top: 0.5rem;
      overflow: hidden;

      .ss-container {
        max-width: 640px;
        width: 100%;
        padding: 24px 16px;
        text-align: center;
        margin: 0 auto;
      }

      .ss-title {
        font-size: 2.8rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        color: var(--ss-text);
        margin-bottom: 2px;
      }

      .ss-title-accent {
        color: var(--ss-amber);
      }

      .ss-game-panel {
        background-color: var(--ss-bg2);
        border: 1px solid var(--ss-border);
        border-radius: 14px;
        padding: 18px;
      }

      .ss-score-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
        padding: 10px 12px;
        background-color: var(--ss-bg3);
        border-radius: 8px;
      }

      .ss-score-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        flex: 1;
      }

      .ss-score-item .ss-label {
        font-size: 0.7rem;
        color: var(--ss-muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .ss-score-item .ss-value {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--ss-text);
        font-variant-numeric: tabular-nums;
      }

      .ss-canvas-wrapper {
        position: relative;
        display: inline-block;
        border-radius: 8px;
        overflow: hidden;
        line-height: 0;
        max-width: 480px;
        width: 100%;
      }

      #ss-game {
        display: block;
        border-radius: 8px;
        width: 100%;
        height: auto;
        cursor: none;
      }

      #ss-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        line-height: normal;
        gap: 2px;
        background: rgba(12, 10, 8, 0.92);
        border-radius: 8px;
        pointer-events: none;
        transition: opacity 0.2s ease;
        z-index: 5;
      }

      #ss-overlay.ss-hidden { opacity: 0; }

      #ss-overlay .ov-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--ss-text);
        margin-bottom: 20px;
      }

      #ss-overlay.ss-start-screen .ov-node-art {
        display: flex;
        gap: 6px;
        margin-bottom: 48px;
        animation: ssFadeSlideUp 0.6s ease both;
      }

      #ss-overlay.ss-start-screen .ov-node-art .nd {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--ss-amber);
      }

      #ss-overlay.ss-start-screen .ov-node-art .nd:nth-child(1) { animation: ssNodeDrift 3.2s ease-in-out infinite; }
      #ss-overlay.ss-start-screen .ov-node-art .nd:nth-child(2) { opacity: 0.8; animation: ssNodeDrift 3.2s ease-in-out 0.15s infinite; }
      #ss-overlay.ss-start-screen .ov-node-art .nd:nth-child(3) { opacity: 0.6; animation: ssNodeDrift 3.2s ease-in-out 0.3s infinite; }
      #ss-overlay.ss-start-screen .ov-node-art .nd:nth-child(4) { opacity: 0.4; animation: ssNodeDrift 3.2s ease-in-out 0.45s infinite; width: 8px; height: 8px; align-self: center; }
      #ss-overlay.ss-start-screen .ov-node-art .nd:nth-child(5) { opacity: 0.2; animation: ssNodeDrift 3.2s ease-in-out 0.6s infinite; width: 6px; height: 6px; align-self: center; }

      #ss-overlay.ss-start-screen .ov-title {
        font-size: 2.2rem;
        line-height: 1.3;
        letter-spacing: 0.14em;
        color: var(--ss-text);
        margin-bottom: 40px;
        animation: ssFadeSlideUp 0.6s ease 0.1s both;
      }

      #ss-overlay.ss-start-screen .ov-title .ss-title-accent {
        color: var(--ss-amber);
      }

      #ss-overlay.ss-start-screen .ov-prompt {
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--ss-text);
        margin-bottom: 36px;
        animation: ssFadeSlideUp 0.6s ease 0.25s both, ssPulseGlow 3s ease-in-out 1s infinite;
      }

      #ss-overlay.ss-start-screen .ov-tagline {
        font-size: 0.85rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--ss-muted);
        margin-bottom: 32px;
        animation: ssFadeSlideUp 0.6s ease 0.2s both;
      }

      #ss-overlay.ss-start-screen .ov-stats-preview {
        display: flex;
        gap: 16px;
        font-size: 0.75rem;
        color: var(--ss-muted);
        margin-top: 12px;
        animation: ssFadeSlideUp 0.6s ease 0.5s both;
      }

      .ov-score-label {
        font-size: 0.7rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--ss-muted);
        margin-bottom: 8px;
        opacity: 0;
        animation: ssFadeUp 0.4s ease forwards;
      }

      .ov-score-big {
        font-size: 2.5rem;
        font-weight: 800;
        color: var(--ss-text);
        margin-bottom: 12px;
        opacity: 0;
        animation: ssScoreDrop 0.6s ease 0.1s forwards;
      }

      .ov-new-high {
        color: var(--ss-amber);
        font-size: 0.85rem;
        font-weight: 700;
        margin-bottom: 8px;
        opacity: 0;
        animation: ssFadeUp 0.4s ease 0.3s forwards, ssPulseGlow 2s ease-in-out 0.7s infinite;
      }

      .ov-rank-name {
        font-size: 1.1rem;
        font-weight: 700;
        margin-bottom: 6px;
        opacity: 0;
        animation: ssFadeUp 0.4s ease 0.35s forwards;
      }

      .ov-rank-visual {
        display: flex;
        flex-direction: column;
        gap: 3px;
        width: 65%;
        max-width: 200px;
        margin-bottom: 10px;
      }

      .ov-rank-bar {
        height: 14px;
        background: var(--ss-bg3);
        border-radius: 3px;
        display: flex;
        align-items: center;
        padding-left: 6px;
        animation: ssRankBar 0.5s ease forwards;
        overflow: hidden;
      }

      .ov-rank-bar.ov-rank-you {
        background: linear-gradient(90deg, var(--ss-amber), var(--ss-gold));
      }

      .ov-rank-pos {
        font-size: 0.55rem;
        font-weight: 700;
        color: var(--ss-text);
        white-space: nowrap;
      }

      .ov-quip {
        font-style: italic;
        color: var(--ss-muted);
        font-size: 0.85rem;
        margin-bottom: 16px;
        opacity: 0;
        animation: ssFadeUp 0.4s ease 0.5s forwards;
      }

      .ov-game-stat {
        font-size: 0.75rem;
        color: var(--ss-text2);
        margin-bottom: 4px;
        opacity: 0;
        animation: ssFadeUp 0.4s ease 0.6s forwards;
      }

      #ss-overlay .ov-sub {
        font-size: 0.9rem;
        color: var(--ss-text2);
      }

      #ss-overlay:not(.ss-start-screen) .ov-sub {
        opacity: 0;
        animation: ssFadeUp 0.4s ease 0.8s forwards, ssPulseGlow 3s ease-in-out 1.2s infinite;
      }

      #ss-overlay.ss-dismissing {
        transition: none !important;
        animation: ssOverlayDismiss 0.4s ease forwards;
      }

      .ss-shield-bar-wrapper {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 12px;
        padding: 0 4px;
      }

      .ss-shield-label {
        font-size: 0.65rem;
        color: var(--ss-muted);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        white-space: nowrap;
      }

      .ss-shield-track {
        flex: 1;
        height: 8px;
        background: var(--ss-bg3);
        border-radius: 4px;
        overflow: hidden;
      }

      .ss-shield-fill {
        height: 100%;
        width: 0%;
        background: var(--ss-amber);
        border-radius: 4px;
        transition: width 0.3s ease;
      }

      .ss-shield-fill.ss-charged {
        animation: ssShieldPulse 1.2s ease-in-out infinite;
      }

      .ss-controls-hint {
        margin-top: 14px;
        font-size: 0.75rem;
        color: var(--ss-muted);
      }

      .ss-skin-selector {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-top: 14px;
        flex-wrap: wrap;
      }

      .ss-skin-circle {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        border: 2px solid transparent;
        cursor: pointer;
        transition: transform 0.15s, border-color 0.15s;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
      }

      .ss-skin-circle:hover { transform: scale(1.15); }
      .ss-skin-circle.ss-active { border-color: var(--ss-text); }
      .ss-skin-circle.ss-locked {
        background: #2A2418 !important;
        cursor: default;
        opacity: 0.6;
      }
      .ss-skin-circle.ss-locked::after {
        content: '\1F512';
        font-size: 9px;
        position: absolute;
      }

      .ss-meta-bar {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        margin-top: 16px;
      }

      .ss-meta-btn {
        background: var(--ss-bg3);
        border: 1px solid var(--ss-border);
        color: var(--ss-text2);
        padding: 6px 16px;
        border-radius: 6px;
        font-size: 0.8rem;
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
      }
      .ss-meta-btn:hover { background: var(--ss-border); color: var(--ss-text); }

      .ss-streak {
        font-size: 0.8rem;
        color: var(--ss-amber);
      }

      .ss-panel {
        background: var(--ss-bg2);
        border: 1px solid var(--ss-border);
        border-radius: 10px;
        padding: 16px;
        margin-top: 12px;
        text-align: left;
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        transition: max-height 0.35s ease, opacity 0.25s ease, padding 0.3s ease, margin 0.3s ease;
      }
      .ss-panel.ss-visible {
        max-height: 600px;
        opacity: 1;
      }
      .ss-panel.ss-collapsed { padding: 0 16px; margin-top: 0; }

      .ss-panel h3 {
        font-size: 0.95rem;
        margin-bottom: 12px;
        color: var(--ss-text);
      }

      .ss-stats-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
      }
      .ss-stat-box {
        background: var(--ss-bg3);
        border-radius: 6px;
        padding: 8px 10px;
      }
      .ss-stat-box .ss-stat-label {
        font-size: 0.7rem;
        color: var(--ss-muted);
        text-transform: uppercase;
      }
      .ss-stat-box .ss-stat-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--ss-text);
      }

      .ss-ach-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
      }
      .ss-ach-item {
        background: var(--ss-bg3);
        border-radius: 6px;
        padding: 8px;
        display: flex;
        gap: 8px;
        align-items: center;
        opacity: 0.35;
        transition: opacity 0.3s;
      }
      .ss-ach-item.ss-earned { opacity: 1; }
      .ss-ach-icon { font-size: 1.3rem; }
      .ss-ach-info { display: flex; flex-direction: column; }
      .ss-ach-name { font-size: 0.75rem; font-weight: 600; color: var(--ss-text); }
      .ss-ach-desc { font-size: 0.65rem; color: var(--ss-muted); }

      #ss-milestone-msg {
        margin-top: 16px;
        font-size: 0.85rem;
        font-style: italic;
        color: var(--ss-muted);
        opacity: 0;
        transition: opacity 1.2s ease;
        min-height: 1.5em;
      }
      #ss-milestone-msg.ss-show { opacity: 1; }

      .ss-toast {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        transform: translateY(-100%);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 6px 12px;
        background: rgba(12, 10, 8, 0.92);
        border-bottom: 2px solid var(--ss-amber);
        font-size: 0.75rem;
        line-height: normal;
        z-index: 10;
        pointer-events: none;
        transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      .ss-toast.ss-show { transform: translateY(0); }
      .ss-toast-icon { font-size: 1.1rem; }
      .ss-toast-text { display: flex; align-items: center; gap: 6px; }
      .ss-toast-name { font-size: 0.75rem; font-weight: 700; color: var(--ss-amber); }
      .ss-toast-desc { font-size: 0.65rem; color: var(--ss-muted); }

      @media (max-width: 520px) {
        .ss-container { padding: 12px 8px; }
        .ss-title { font-size: 2rem; }
        .ss-score-bar { padding: 8px; }
        .ss-score-item .ss-value { font-size: 1rem; }
        .ss-ach-grid, .ss-stats-grid { grid-template-columns: 1fr; }
      }
    }
  </style>

  <script>
    (function() {
    'use strict';

    // ── CONSTANTS ────────────────────────────────────────────────
    var CW = 480, CH = 480;
    var PLAYER_RADIUS = 8;
    var PROJ_RADIUS = 4;
    var TOKEN_RADIUS = 10;
    var SHIELD_RADIUS = 42;
    var SHIELD_DURATION = 3.0;
    var SHIELD_CHARGE_NEEDED = 5;
    var COMBO_WINDOW = 1.5;
    var GRAZE_MARGIN = 8;
    var TRAIL_LENGTH = 4;
    var MAX_PROJECTILES = 300;
    var MAX_PARTICLES = 500;
    var MAX_TOKENS = 5;
    var MAX_FLOAT_TEXTS = 30;

    var COLORS = {
      bg: '#0C0A08',
      player: '#E8A836',
      playerGlow: '#FFF8E7',
      projRed: '#D4483B',
      projHeavy: '#8B4513',
      tokenGold: '#F5C842',
      tokenSparkle: '#FFFACD',
      shield: '#E8A836',
      text: '#F1EDE4',
      text2: '#A89E8C',
      muted: '#6B6252',
      dots: '#3A3428'
    };

    var WAVE_NAMES = [
      'Panda', 'Penguin', 'Hummingbird', 'Pigeon', 'Mobilegeddon',
      'RankBrain', 'Possum', 'Fred', 'Medic', 'BERT',
      'Core Update', 'Passage Ranking', 'MUM', 'Helpful Content', 'SpamBrain',
      'March Core', 'Link Spam', 'Reviews Update', 'Site Rep Abuse', 'Navboost'
    ];

    var RANK_TIERS = [
      { min: 2500, name: 'AI Overview',       color: '#A78BFA' },
      { min: 1500, name: 'Featured Snippet',  color: '#60A5FA' },
      { min: 800,  name: 'Position #3',       color: '#34D399' },
      { min: 500,  name: 'Top 10',            color: '#10B981' },
      { min: 300,  name: 'Page 2',            color: '#F5C842' },
      { min: 150,  name: 'Page 3',            color: '#E8A836' },
      { min: 50,   name: 'Noindexed',         color: '#D4483B' },
      { min: 0,    name: 'Crawl Error (404)',  color: '#8B4513' }
    ];

    // ── DOM ──────────────────────────────────────────────────────
    var canvas = document.getElementById('ss-game');
    var ctx = canvas.getContext('2d');
    var scoreEl = document.getElementById('ss-score');
    var bestEl = document.getElementById('ss-best');
    var waveEl = document.getElementById('ss-wave');
    var comboEl = document.getElementById('ss-combo');
    var overlay = document.getElementById('ss-overlay');
    var shieldFill = document.getElementById('ss-shield-fill');
    var controlsHint = document.getElementById('ss-controls');
    var skinContainer = document.getElementById('ss-skins');
    var statsBtn = document.getElementById('ss-stats-btn');
    var achBtn = document.getElementById('ss-ach-btn');
    var statsPanel = document.getElementById('ss-stats-panel');
    var achPanel = document.getElementById('ss-ach-panel');
    var streakDisplay = document.getElementById('ss-streak-display');
    var milestoneMsg = document.getElementById('ss-milestone-msg');
    var toastEl = document.getElementById('ss-achievement-toast');

    // ── RETINA ──────────────────────────────────────────────────
    var dpr = window.devicePixelRatio || 1;
    canvas.width = CW * dpr;
    canvas.height = CH * dpr;
    canvas.style.width = CW + 'px';
    canvas.style.height = CH + 'px';
    ctx.scale(dpr, dpr);

    // ── TOUCH DETECTION ─────────────────────────────────────────
    var isTouchDevice = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);
    if (isTouchDevice) {
      controlsHint.textContent = 'Touch to move \u00B7 Tap for shield';
      canvas.style.cursor = 'default';
    }

    // ── SKINS ───────────────────────────────────────────────────
    var SKINS = {
      amber:   { name: 'Amber',   color: '#E8A836', unlocked: true },
      green:   { name: 'Green',   color: '#34D399', req: '15 games', check: function(s) { return s.totalGames >= 15; } },
      blue:    { name: 'Blue',    color: '#60A5FA', req: 'Score 500+', check: function(s) { return s.highScore >= 500; } },
      white:   { name: 'White',   color: '#F1EDE4', req: '50 games', check: function(s) { return s.totalGames >= 50; } },
      rainbow: { name: 'Rainbow', color: 'rainbow', req: 'Konami', check: function(s) { return s.konami; } }
    };

    function isSkinUnlocked(key) {
      var sk = SKINS[key];
      if (sk.unlocked) return true;
      return sk.check ? sk.check(stats) : false;
    }

    function getPlayerColor(time) {
      if (activeSkin === 'rainbow') {
        return 'hsl(' + ((time * 90) % 360) + ', 80%, 65%)';
      }
      return SKINS[activeSkin] ? SKINS[activeSkin].color : COLORS.player;
    }

    // ── ACHIEVEMENTS ────────────────────────────────────────────
    var ACHIEVEMENTS = {
      firstToken:   { name: 'First Token',   desc: 'Collect your first ranking boost',     icon: '\u2B50' },
