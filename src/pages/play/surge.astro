    function spawnParticle(x, y, color, vx, vy, size, life) {
      for (var i = 0; i < MAX_PARTICLES; i++) {
        if (!particles[i].active) {
          var p = particles[i];
          p.active = true; p.x = x; p.y = y; p.vx = vx; p.vy = vy;
          p.color = color; p.size = size;
          p.life = life; p.maxLife = life;
          return;
        }
      }
    }

    function spawnParticles(x, y, color, count, speed) {
      for (var i = 0; i < count; i++) {
        var angle = Math.random() * Math.PI * 2;
        var spd = speed * (0.5 + Math.random());
        var sz = 2 + Math.random() * 3;
        var lf = 0.3 + Math.random() * 0.4;
        spawnParticle(x, y, color, Math.cos(angle) * spd, Math.sin(angle) * spd, sz, lf);
      }
    }

    function addFloatingText(text, x, y, color, size) {
      for (var i = 0; i < MAX_FLOAT_TEXTS; i++) {
