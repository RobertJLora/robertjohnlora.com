---
import Layout from '../layouts/Layout.astro';

interface Res { name: string; href: string; desc: string; descLink?: { before: string; text: string; href: string; after: string } }
const groups: { title: string; items: Res[] }[] = [
  {
    title: 'seo blogs & publications',
    items: [
      { name: 'ahrefs blog', href: 'https://ahrefs.com/blog', desc: 'data-driven SEO research from the tool I pull most of my keyword and backlink data from' },
      { name: 'search engine land', href: 'https://searchengineland.com', desc: 'where I first hear about most algorithm updates' },
      { name: 'search engine journal', href: 'https://searchenginejournal.com', desc: 'tactical how-to guides. less news, more "here\'s how to actually do it"' },
      { name: 'kevin indig', href: 'https://www.kevin-indig.com', desc: 'growth memo newsletter. consistently the best thinking on where SEO meets product' },
    ],
  },
  {
    title: 'seo people',
    items: [
      { name: 'lily ray', href: 'https://x.com/lilyraynyc', desc: 'the person I check first after every google update' },
      { name: 'chris long', href: 'https://x.com/gofishchris', desc: 'Go Fish Digital. sharp on technical SEO and link building at scale' },
      { name: 'eli schwartz', href: 'https://x.com/5le', desc: 'product-led SEO. asks "should this page exist at all" before "how do we rank it"' },
      { name: 'will critchlow', href: 'https://x.com/willcritchlow', desc: 'SEO testing and experimentation' },
      { name: 'aleyda solís', href: 'https://x.com/aaborstings', desc: 'international SEO' },
    ],
  },
  {
    title: 'ai people & channels',
    items: [
      { name: 'andrej karpathy', href: 'https://x.com/karpathy', desc: 'makes neural networks make sense even if you don\'t write code. his "let\'s build GPT from scratch" video is the best intro to how LLMs work' },
      { name: 'ethan mollick', href: 'https://x.com/emollick', desc: 'the rare academic who builds with the tools he studies. his AI usage frameworks actually hold up at work' },
      { name: 'swyx (shawn wang)', href: 'https://x.com/swyx', desc: 'first to surface AI news that matters. runs the latent space podcast' },
      { name: 'boris cherny', href: 'https://x.com/bcherny', desc: 'claude code creator' },
      { name: 'thariq', href: 'https://x.com/trq212', desc: 'claude code team' },
      { name: 'elevenlabs', href: 'https://elevenlabs.io', desc: 'voice AI experimentation. consistently early on new model demos' },
      { name: 'AI Explained', href: 'https://www.youtube.com/@aiexplained-official', desc: 'model breakdowns and news' },
      { name: 'AI jason', href: 'https://www.youtube.com/@AIJasonZ', desc: 'vibe coding and practical experiments' },
      { name: 'claude code releases', href: 'https://github.com/anthropics/claude-code/releases', desc: 'changelog and updates' },
    ],
  },
  {
    title: 'podcasts',
    items: [
      { name: 'latent space', href: 'https://www.latent.space/podcast', desc: 'the AI engineer podcast (Swyx & Alessio). gets technical without losing the thread' },
      { name: 'no priors', href: 'https://www.nopriors.ai', desc: 'AI, technology and startups (Elad Gil & Sarah Guo)' },
      { name: 'dwarkesh podcast', href: 'https://www.dwarkeshpatel.com/podcast', desc: 'deep dives with AI leaders' },
    ],
  },
  {
    title: 'newsletters',
    items: [
      { name: 'simon willison', href: 'https://simonwillison.net', desc: 'one of the best at experimenting with LLMs in public. reads everything, tries everything, shares what he finds' },
      { name: 'eugene yan', href: 'https://www.eugeneyan.com', desc: 'RAG, evals, prompting strategies' },
      { name: "ben's bites", href: 'https://www.bensbites.co', desc: 'daily AI digest' },
    ],
  },
  {
    title: 'tools I use daily',
    items: [
      { name: 'ahrefs', href: 'https://ahrefs.com', desc: 'backlinks, keywords, competitive research' },
      { name: 'semrush', href: 'https://www.semrush.com', desc: 'AI topic research and content gap analysis' },
      { name: 'screaming frog', href: 'https://www.screamingfrog.co.uk', desc: 'technical audits' },
      { name: 'google search console', href: 'https://search.google.com/search-console', desc: 'the actual source of truth for search performance' },
      { name: 'pitchbox', href: 'https://pitchbox.com', desc: 'outreach at scale' },
      { name: 'claude', href: 'https://claude.ai', desc: "the AI I've built everything on this site with" },
      { name: 'claude code', href: 'https://docs.anthropic.com/en/docs/claude-code', desc: '', descLink: { before: 'the CLI where the ', text: '45 builds', href: '/builds/', after: ' happened' } },
      { name: 'firecrawl', href: 'https://www.firecrawl.dev', desc: 'web scraping and site crawling' },
    ],
  },
];
---

<Layout
  title="SEO & AI Resources"
  description="Curated SEO and AI resources: blogs, newsletters, podcasts, and tools. The information diet that keeps Robert Lora current on search and AI."
  currentSlug="resources"
>
  <p class="echo" aria-hidden="true"><span class="cwd">~/notes</span><span class="chev"></span><span class="cmd">ls resources</span></p>
  <nav class="switch" aria-label="notes">
    <a href="/resources/" aria-current="page">resources</a>
    <a href="/quotes/">quotes</a>
  </nav>
  <h1 class="page-title">resources</h1>
  <p class="lede">my information diet for staying current on AI and SEO.</p>

  {groups.map((g) => (
    <section class="res-group">
      <h2>{g.title}</h2>
      <ul class="res-list">
        {g.items.map((r) => (
          <li>
            <a class="res-name" href={r.href} target="_blank" rel="noopener noreferrer">{r.name}</a>
            <span class="res-desc">{r.descLink ? <Fragment>{r.descLink.before}<a href={r.descLink.href}>{r.descLink.text}</a>{r.descLink.after}</Fragment> : r.desc}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Layout>
